# Copy to `.env` and fill in your LLM credentials. `run.sh` sources this file
# (when present) before running tests/verification, so the LLM-dependent
# integration tests and PERF can reach your provider.
#
# These are the same variables read by `conf/config.yaml`'s api_key/base_url
# auto-detection. Provider-specific variables win over `config.yaml` placeholders.

# DeepSeek (default provider in conf/config.yaml)
DEEPSEEK_API_KEY=""
DEEPSEEK_API_BASE="https://api.deepseek.com/v1"

# OpenAI
#OPENAI_API_KEY=""
#OPENAI_API_BASE="https://api.openai.com/v1"

# Anthropic
#ANTHROPIC_API_KEY=""
