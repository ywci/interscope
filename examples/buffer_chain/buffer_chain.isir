isir_version: "0.1"
module:
  name: buffer_chain
  clocks:
    - name: clk
      edge: posedge
  resets:
    - name: rst
      polarity: active_high
      async: false
      affects: all
  inputs:
    - name: d0
      direction: input
      type: "bits<4>"
  state:
    - name: wire0
      kind: register
      type: "bits<4>"
    - name: out1
      kind: register
      type: "bits<4>"
  components:
    - name: bufA
      module: "examples/buffer/buffer.isir"
      port_map:
        d: d0
        q: wire0
    - name: bufB
      module: "examples/buffer/buffer.isir"
      port_map:
        d: wire0
        q: out1
  properties:
    - name: bufA_passes_d0
      kind: transition
      expression:
        kind: transition
        rule: bufA_update
        operand: (eq (read wire0) d0)
    - name: bufB_passes_wire0
      kind: transition
      expression:
        kind: transition
        rule: bufB_update
        operand: (eq (read out1) (prev wire0))
  proof_obligations:
    - property: bufA_passes_d0
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: bufB_passes_wire0
      status: unproved
      engine: theorem_proving
      backend: koika
