isir_version: "0.1"
module:
  name: div
  clocks:
    - name: clk
      edge: posedge
  resets:
    - name: rst
      polarity: active_high
      async: false
      affects: all
  inputs:
    - name: start
      direction: input
      type: "bool"
    - name: dividend
      direction: input
      type: "bits<16>"
    - name: divisor
      direction: input
      type: "bits<16>"
  outputs:
    - name: quotient
      direction: output
      type: "bits<16>"
    - name: remainder
      direction: output
      type: "bits<16>"
    - name: done
      direction: output
      type: "bool"
  state:
    - name: rem
      kind: register
      type: "bits<16>"
      initial: 0
    - name: quot
      kind: register
      type: "bits<16>"
      initial: 0
    - name: divisor_reg
      kind: register
      type: "bits<16>"
      initial: 0
    - name: dividend_init
      kind: register
      type: "bits<16>"
      initial: 0
    - name: count
      kind: register
      type: "bits<5>"
      initial: 0
    - name: done
      kind: register
      type: "bool"
      initial: false
    - name: quotient
      kind: register
      type: "bits<16>"
      initial: 0
    - name: remainder
      kind: register
      type: "bits<16>"
      initial: 0
  rules:
    - name: load
      condition: start
      action:
        - (write rem 0)
        - (write quot (read dividend))
        - (write divisor_reg (read divisor))
        - (write dividend_init (read dividend))
        - (write count 16)
        - (write done false)
    - name: sub_step
      condition: (and (not (read done)) (and (gt (read count) 0) (ge (add (mul (read
        rem) 2) (slice (read quot) 15 15)) (read divisor_reg))))
      action:
        - (write rem (sub (add (mul (read rem) 2) (slice (read quot) 15 15)) (read
          divisor_reg)))
        - (write quot (add (mul (read quot) 2) 1))
        - (write count (sub (read count) 1))
    - name: shift_step
      condition: (and (not (read done)) (and (gt (read count) 0) (lt (add (mul (read
        rem) 2) (slice (read quot) 15 15)) (read divisor_reg))))
      action:
        - (write rem (add (mul (read rem) 2) (slice (read quot) 15 15)))
        - (write quot (mul (read quot) 2))
        - (write count (sub (read count) 1))
    - name: finish
      condition: (and (not (read done)) (eq (read count) 0))
      action:
        - (write done true)
        - (write quotient (read quot))
        - (write remainder (read rem))
  properties:
    - name: done_implies_remainder_equals_rem
      kind: safety
      expression:
        kind: always
        operand: (implies done (eq remainder (read rem)))
    - name: done_implies_quotient_equals_quot
      kind: safety
      expression:
        kind: always
        operand: (implies done (eq quotient (read quot)))
    - name: done_implies_count_zero
      kind: safety
      expression:
        kind: always
        operand: (implies done (eq (read count) 0))
    - name: remainder_lt_divisor
      kind: safety
      expression:
        kind: always
        operand: (implies (gt (read divisor_reg) 0) (lt (read rem) (read divisor_reg)))
    - name: divider_loads_operands
      kind: transition
      expression:
        kind: transition
        rule: load
        operand: (and (eq (read rem) 0) (and (eq (read quot) (prev dividend)) (and
          (eq (read divisor_reg) (prev divisor)) (and (eq (read dividend_init) (prev
          dividend)) (and (eq (read count) 16) (eq done False))))))
    - name: remainder_subtracts_divisor
      kind: transition
      expression:
        kind: transition
        rule: sub_step
        operand: (and (eq (read rem) (sub (add (mul (prev rem) 2) (slice (prev quot)
          15 15)) (prev divisor_reg))) (and (eq (read quot) (add (mul (prev quot)
          2) 1)) (eq (read count) (sub (prev count) 1))))
    - name: remainder_shifts_left
      kind: transition
      expression:
        kind: transition
        rule: shift_step
        operand: (and (eq (read rem) (add (mul (prev rem) 2) (slice (prev quot) 15
          15))) (and (eq (read quot) (mul (prev quot) 2)) (eq (read count) (sub (prev
          count) 1))))
    - name: division_finalizes_result
      kind: transition
      expression:
        kind: transition
        rule: finish
        operand: (and (eq done True) (and (eq quotient (prev quot)) (eq remainder
          (prev rem))))
  proof_obligations:
    - property: divider_loads_operands
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: remainder_subtracts_divisor
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: remainder_shifts_left
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: division_finalizes_result
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: done_implies_remainder_equals_rem
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: done_implies_quotient_equals_quot
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: done_implies_count_zero
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: remainder_lt_divisor
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
