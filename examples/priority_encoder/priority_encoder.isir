isir_version: "0.1"
module:
  name: priority_encoder
  clocks:
    - name: clk
      edge: posedge
  resets:
    - name: rst
      polarity: active_high
      async: false
      affects: all
  inputs:
    - name: data
      direction: input
      type: "bits<8>"
  outputs:
    - name: enc
      direction: output
      type: "bits<3>"
    - name: valid
      direction: output
      type: "bool"
  state:
    - name: enc
      kind: register
      type: "bits<3>"
      initial: 0
    - name: valid
      kind: register
      type: "bool"
      initial: false
  functions:
    - name: prio_enc
      params:
        - name: d
          type: "bits<8>"
      return: "bits<3>"
      body: (ite (eq (slice d 7 7) 1) 7 (ite (eq (slice d 6 6) 1) 6 (ite (eq (slice
        d 5 5) 1) 5 (ite (eq (slice d 4 4) 1) 4 (ite (eq (slice d 3 3) 1) 3 (ite (eq
        (slice d 2 2) 1) 2 (ite (eq (slice d 1 1) 1) 1 (ite (eq (slice d 0 0) 1) 0
        0))))))))
  rules:
    - name: encode
      condition: "true"
      action:
        - (write enc (ite (eq (slice (read data) 7 7) 1) 7 (ite (eq (slice (read data)
          6 6) 1) 6 (ite (eq (slice (read data) 5 5) 1) 5 (ite (eq (slice (read data)
          4 4) 1) 4 (ite (eq (slice (read data) 3 3) 1) 3 (ite (eq (slice (read data)
          2 2) 1) 2 (ite (eq (slice (read data) 1 1) 1) 1 (ite (eq (slice (read data)
          0 0) 1) 0 0)))))))))
        - (write valid (neq (read data) 0))
  properties:
    - name: valid_iff_data_nonzero
      kind: safety
      expression:
        kind: always
        operand: (eq valid (neq data 0))
    - name: enc_correct
      kind: transition
      expression:
        kind: transition
        rule: encode
        operand: (and (eq enc (prio_enc data)) (eq valid (neq data 0)))
  proof_obligations:
    - property: enc_correct
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: valid_iff_data_nonzero
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: valid_iff_data_nonzero
      engine: model_checking
