isir_version: "0.1"
module:
  name: systolic
  clocks:
    - name: clk
      edge: posedge
  resets:
    - name: rst
      polarity: active_high
      async: false
      affects: all
  inputs:
    - name: w00
      direction: input
      type: "bits<8>"
    - name: w01
      direction: input
      type: "bits<8>"
    - name: w10
      direction: input
      type: "bits<8>"
    - name: w11
      direction: input
      type: "bits<8>"
    - name: a0
      direction: input
      type: "bits<8>"
    - name: a1
      direction: input
      type: "bits<8>"
    - name: b0
      direction: input
      type: "bits<8>"
    - name: b1
      direction: input
      type: "bits<8>"
    - name: start
      direction: input
      type: "bool"
    - name: valid
      direction: input
      type: "bool"
  outputs:
    - name: acc00
      direction: output
      type: "bits<32>"
    - name: acc01
      direction: output
      type: "bits<32>"
    - name: acc10
      direction: output
      type: "bits<32>"
    - name: acc11
      direction: output
      type: "bits<32>"
  state:
    - name: acc00
      kind: register
      type: "bits<32>"
      initial: 0
    - name: acc01
      kind: register
      type: "bits<32>"
      initial: 0
    - name: acc10
      kind: register
      type: "bits<32>"
      initial: 0
    - name: acc11
      kind: register
      type: "bits<32>"
      initial: 0
    - name: weight00
      kind: register
      type: "bits<8>"
      initial: 0
    - name: weight01
      kind: register
      type: "bits<8>"
      initial: 0
    - name: weight10
      kind: register
      type: "bits<8>"
      initial: 0
    - name: weight11
      kind: register
      type: "bits<8>"
      initial: 0
    - name: a_in0
      kind: register
      type: "bits<8>"
      initial: 0
    - name: a_in1
      kind: register
      type: "bits<8>"
      initial: 0
    - name: b_in0
      kind: register
      type: "bits<8>"
      initial: 0
    - name: b_in1
      kind: register
      type: "bits<8>"
      initial: 0

  directives:
    - type: assume
      name: operands_are_8_bit
      expression: (and (le a0 255)
                   (and (le a1 255)
                   (and (le b0 255)
                   (and (le b1 255)
                   (and (le w00 255)
                   (and (le w01 255)
                   (and (le w10 255)
                        (le w11 255))))))))

  rules:
    - name: load
      condition: start
      action:
        - (write weight00 (read w00))
        - (write weight01 (read w01))
        - (write weight10 (read w10))
        - (write weight11 (read w11))
        - (write a_in0 (read a0))
        - (write a_in1 (read a1))
        - (write b_in0 (read b0))
        - (write b_in1 (read b1))
    - name: mac
      condition: valid
      action:
        - (write acc00 (add (read acc00) (mul (read a_in0) (read weight00))))
        - (write acc01 (add (read acc01) (mul (read a_in0) (read weight01))))
        - (write acc10 (add (read acc10) (mul (read a_in1) (read weight10))))
        - (write acc11 (add (read acc11) (mul (read a_in1) (read weight11))))
  properties:
    - name: acc_nonneg
      kind: safety
      expression:
        kind: always
        operand: (and (ge (read acc00) 0)
                  (and (ge (read acc01) 0)
                  (and (ge (read acc10) 0)
                       (ge (read acc11) 0))))
    - name: weights_nonneg
      kind: safety
      expression:
        kind: always
        operand: (and (ge (read weight00) 0)
                  (and (ge (read weight01) 0)
                  (and (ge (read weight10) 0)
                       (ge (read weight11) 0))))
    - name: acc_monotonic
      kind: safety
      expression:
        kind: always
        operand: (ge (read acc00) 0)
    - name: weights_loaded_correctly
      kind: transition
      expression:
        kind: transition
        rule: load
        operand: (and (eq (read weight00) w00)
                  (and (eq (read weight01) w01)
                  (and (eq (read weight10) w10)
                       (eq (read weight11) w11))))
    - name: operands_loaded
      kind: transition
      expression:
        kind: transition
        rule: load
        operand: (and (eq (read a_in0) a0)
                  (and (eq (read a_in1) a1)
                  (and (eq (read b_in0) b0)
                       (eq (read b_in1) b1))))
    - name: a_in0_bounded
      kind: safety
      expression:
        kind: always
        operand: (le (read a_in0) 255)
    - name: weight00_bounded
      kind: safety
      expression:
        kind: always
        operand: (le (read weight00) 255)
  proof_obligations:
    - property: acc_nonneg
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: weights_nonneg
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: acc_monotonic
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: weights_loaded_correctly
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: operands_loaded
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: a_in0_bounded
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: weight00_bounded
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: acc_nonneg
      engine: model_checking
