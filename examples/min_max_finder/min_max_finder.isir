isir_version: "0.1"
module:
  name: min_max_finder
  clocks:
    - name: clk
      edge: posedge
  resets:
    - name: rst
      polarity: active_high
      async: false
      affects: all
  inputs:
    - name: valid
      direction: input
      type: "bool"
    - name: data
      direction: input
      type: "bits<8>"
  outputs:
    - name: min_val
      direction: output
      type: "bits<8>"
    - name: max_val
      direction: output
      type: "bits<8>"
  state:
    - name: min_val
      kind: register
      type: "bits<8>"
      initial: 0
    - name: max_val
      kind: register
      type: "bits<8>"
      initial: 0
    - name: first
      kind: register
      type: "bool"
      initial: true
    - name: count
      kind: register
      type: "bits<8>"
      initial: 0
  rules:
    - name: update
      condition: valid
      action:
        - (write min_val (ite (read first) data (ite (lt data (read min_val)) data
          (read min_val))))
        - (write max_val (ite (read first) data (ite (gt data (read max_val)) data
          (read max_val))))
        - (write count (add (read count) 1))
        - (write first false)
  properties:
    - name: min_le_max
      kind: safety
      expression:
        kind: always
        operand: (le min_val max_val)
    - name: min_leq_max
      kind: safety
      expression:
        kind: always
        operand: (le min_val max_val)
    - name: running_min_max_updated
      kind: transition
      expression:
        kind: transition
        rule: update
        operand: (and (eq min_val (ite (prev first) data (ite (lt data (prev min_val))
          data (prev min_val)))) (and (eq max_val (ite (prev first) data (ite (gt
          data (prev max_val)) data (prev max_val)))) (and (eq (read count) (add (prev
          count) 1)) (eq (read first) False))))
  proof_obligations:
    - property: running_min_max_updated
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: min_le_max
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: min_le_max
      engine: model_checking
    - property: min_leq_max
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
