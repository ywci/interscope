isir_version: "0.1"
module:
  name: chi_home
  clocks:
    - name: clk
      edge: posedge
  resets:
    - name: rst
      polarity: active_high
      async: false
      affects: all
  inputs:
    # REQ channel (RN -> HN).
    - name: req_valid
      direction: input
      type: "bool"
    - name: req_write
      direction: input
      type: "bool"
    - name: req_addr
      direction: input
      type: "bits<4>"
    - name: req_core
      direction: input
      type: "bool"      # which RN issued the request (false=RN0, true=RN1)
    - name: req_data
      direction: input
      type: "bits<8>"
    # RSP channel (RN -> HN): snoop response.
    - name: snp_rsp_valid
      direction: input
      type: "bool"
  state:
    # Directory: the MESI state each RN currently holds (mirrors the RNs' L1D).
    - name: c0_state
      kind: register
      type: "bits<2>"
      initial: 0
    - name: c0_addr
      kind: register
      type: "bits<4>"
      initial: 0
    - name: c1_state
      kind: register
      type: "bits<2>"
      initial: 0
    - name: c1_addr
      kind: register
      type: "bits<4>"
      initial: 0
    # Transaction state: a request in flight.
    - name: pending
      kind: register
      type: "bool"
      initial: false
    - name: pending_core
      kind: register
      type: "bool"
      initial: false
    - name: pending_write
      kind: register
      type: "bool"
      initial: false
    - name: pending_addr
      kind: register
      type: "bits<4>"
      initial: 0
    - name: snooped
      kind: register
      type: "bool"
      initial: false
    # REQ flow control: free REQ buffer slots (credit-based back-pressure).
    - name: req_credits
      kind: register
      type: "bits<2>"
      initial: 2
    # SNP channel output (HN -> RN).
    - name: snp_valid
      kind: register
      type: "bool"
      initial: false
    - name: snp_core
      kind: register
      type: "bool"
      initial: false
    - name: snp_addr
      kind: register
      type: "bits<4>"
      initial: 0
    - name: snp_op
      kind: register
      type: "bool"
      initial: false
    # RSP channel output (HN -> RN): grant.
    - name: grant_valid
      kind: register
      type: "bool"
      initial: false
    - name: grant_core
      kind: register
      type: "bool"
      initial: false
    - name: grant_write
      kind: register
      type: "bool"
      initial: false
    - name: grant_addr
      kind: register
      type: "bits<4>"
      initial: 0
  functions:
    - name: has_line
      params: [{name: s, type: "bits<2>"}, {name: a, type: "bits<4>"}, {name: ra, type: "bits<4>"}]
      return: "bool"
      body: (and (neq s 0) (eq a ra))
    - name: is_modified
      params: [{name: s, type: "bits<2>"}]
      return: "bool"
      body: (eq s 3)
  rules:
    # REQ: latch the request and issue a snoop to the peer RN.  Gated on an
    # available REQ credit (back-pressure when the home is full).
    - name: request
      condition: (and (and (not (read pending)) req_valid) (neq (read req_credits) 0))
      action:
        - (write pending true)
        - (write pending_core req_core)
        - (write pending_write req_write)
        - (write pending_addr req_addr)
        - (write snooped false)
        - (write req_credits (sub (read req_credits) 1))
        - (write snp_valid true)
        - (write snp_core (not req_core))
        - (write snp_addr req_addr)
        - (write snp_op req_write)
    # Snoop response arrived: record it and update the peer's directory entry.
    - name: snoop
      condition: (and (and (read pending) (not (read snooped))) snp_rsp_valid)
      action:
        - (write snooped true)
        - (write snp_valid false)
        - (write c0_state (ite (eq (read snp_core) false) (ite (read snp_op) 0 1) (read c0_state)))
        - (write c1_state (ite (eq (read snp_core) true) (ite (read snp_op) 0 1) (read c1_state)))
    # Grant the requester (snoop-before-grant): update the requester's directory.
    - name: grant
      condition: (and (read pending) (read snooped))
      action:
        - (write grant_valid true)
        - (write grant_core (read pending_core))
        - (write grant_write (read pending_write))
        - (write grant_addr (read pending_addr))
        - (write c0_state (ite (eq (read pending_core) false) (ite (read pending_write) 3 1) (read c0_state)))
        - (write c0_addr (ite (eq (read pending_core) false) (read pending_addr) (read c0_addr)))
        - (write c1_state (ite (eq (read pending_core) true) (ite (read pending_write) 3 1) (read c1_state)))
        - (write c1_addr (ite (eq (read pending_core) true) (read pending_addr) (read c1_addr)))
        - (write pending false)
        - (write snooped false)
        # Return the REQ credit now that the transaction completed.
        - (write req_credits (add (read req_credits) 1))
    # Deassert the grant one cycle after it was issued.
    - name: clear_grant
      condition: (not (and (read pending) (read snooped)))
      action:
        - (write grant_valid false)
  # The full SWMR is true by snoop-before-grant ordering (the peer is invalidated
  # before the requester is granted), so it is declared as an invariant.  The
  # snoop-clears-peer and grant-follows-snoop lemmas are structural corollaries of
  # the `snoop`/`grant` rules.
  invariants:
    - name: single_writer
      operand: (not (and (and (is_modified (read c0_state)) (is_modified (read c1_state)))
                        (eq (read c0_addr) (read c1_addr))))
    # Flow-control soundness: REQ credits stay within [0, 2].  This follows from
    # the stronger invariant `req_credits + pending = 2` (a credit is consumed on
    # REQ and returned on grant), which is assumed rather than auto-proved.
    - name: credits_bounded
      operand: (and (ge (read req_credits) 0) (le (read req_credits) 2))
