isir_version: "0.1"
module:
  name: chi_home
  clocks:
    - name: clk
      edge: posedge
  resets:
    - name: rst
      polarity: active_high
      async: false
      affects: all
  inputs:
    - name: req_valid
      direction: input
      type: "bool"
    - name: req_write
      direction: input
      type: "bool"
    - name: req_addr
      direction: input
      type: "bits<4>"
    - name: req_core
      direction: input
      type: "bool"
    - name: req_data
      direction: input
      type: "bits<8>"
    - name: snp_rsp_valid
      direction: input
      type: "bool"
  state:
    - name: c0_state
      kind: register
      type: "bits<2>"
      initial: 0
    - name: c0_addr
      kind: register
      type: "bits<4>"
      initial: 0
    - name: c1_state
      kind: register
      type: "bits<2>"
      initial: 0
    - name: c1_addr
      kind: register
      type: "bits<4>"
      initial: 0
    - name: pending
      kind: register
      type: "bool"
      initial: false
    - name: pending_core
      kind: register
      type: "bool"
      initial: false
    - name: pending_write
      kind: register
      type: "bool"
      initial: false
    - name: pending_addr
      kind: register
      type: "bits<4>"
      initial: 0
    - name: snooped
      kind: register
      type: "bool"
      initial: false
    - name: req_credits
      kind: register
      type: "bits<2>"
      initial: 2
    - name: snp_valid
      kind: register
      type: "bool"
      initial: false
    - name: snp_core
      kind: register
      type: "bool"
      initial: false
    - name: snp_addr
      kind: register
      type: "bits<4>"
      initial: 0
    - name: snp_op
      kind: register
      type: "bool"
      initial: false
    - name: grant_valid
      kind: register
      type: "bool"
      initial: false
    - name: grant_core
      kind: register
      type: "bool"
      initial: false
    - name: grant_write
      kind: register
      type: "bool"
      initial: false
    - name: grant_addr
      kind: register
      type: "bits<4>"
      initial: 0
  functions:
    - name: has_line
      params:
        - name: s
          type: "bits<2>"
        - name: a
          type: "bits<4>"
        - name: ra
          type: "bits<4>"
      return: "bool"
      body: (and (neq s 0) (eq a ra))
    - name: is_modified
      params:
        - name: s
          type: "bits<2>"
      return: "bool"
      body: (eq s 3)
  rules:
    - name: request
      condition: (and (and (not (read pending)) req_valid) (neq (read req_credits)
        0))
      action:
        - (write pending true)
        - (write pending_core req_core)
        - (write pending_write req_write)
        - (write pending_addr req_addr)
        - (write snooped false)
        - (write req_credits (sub (read req_credits) 1))
        - (write snp_valid true)
        - (write snp_core (not req_core))
        - (write snp_addr req_addr)
        - (write snp_op req_write)
    - name: snoop
      condition: (and (and (read pending) (not (read snooped))) snp_rsp_valid)
      action:
        - (write snooped true)
        - (write snp_valid false)
        - (write c0_state (ite (eq (read snp_core) false) (ite (read snp_op) 0 1)
          (read c0_state)))
        - (write c1_state (ite (eq (read snp_core) true) (ite (read snp_op) 0 1) (read
          c1_state)))
    - name: grant
      condition: (and (read pending) (read snooped))
      action:
        - (write grant_valid true)
        - (write grant_core (read pending_core))
        - (write grant_write (read pending_write))
        - (write grant_addr (read pending_addr))
        - (write c0_state (ite (eq (read pending_core) false) (ite (read pending_write)
          3 1) (read c0_state)))
        - (write c0_addr (ite (eq (read pending_core) false) (read pending_addr) (read
          c0_addr)))
        - (write c1_state (ite (eq (read pending_core) true) (ite (read pending_write)
          3 1) (read c1_state)))
        - (write c1_addr (ite (eq (read pending_core) true) (read pending_addr) (read
          c1_addr)))
        - (write pending false)
        - (write snooped false)
        - (write req_credits (add (read req_credits) 1))
    - name: clear_grant
      condition: (not (and (read pending) (read snooped)))
      action:
        - (write grant_valid false)
  properties:
    - name: has_line_holds_line
      kind: safety
      expression:
        kind: always
        operand: (implies (has_line (read c0_state) (read c0_addr) (read c0_addr))
          (neq (read c0_state) 0))
    - name: request_accepts_and_snoops
      kind: transition
      expression:
        kind: transition
        rule: request
        operand: (and (eq (read pending) True) (and (eq (read pending_core) req_core)
          (and (eq (read pending_write) req_write) (and (eq (read pending_addr) req_addr)
          (and (eq (read snooped) False) (and (eq (read req_credits) (sub (prev req_credits)
          1)) (and (eq (read snp_valid) True) (and (eq (read snp_core) (not req_core))
          (and (eq (read snp_addr) req_addr) (eq (read snp_op) req_write))))))))))
    - name: snoop_response_updates_peer_state
      kind: transition
      expression:
        kind: transition
        rule: snoop
        operand: (and (eq (read snooped) True) (and (eq (read snp_valid) False) (and
          (eq (read c0_state) (ite (eq (prev snp_core) False) (ite (prev snp_op) 0
          1) (prev c0_state))) (eq (read c1_state) (ite (eq (prev snp_core) True)
          (ite (prev snp_op) 0 1) (prev c1_state))))))
    - name: grant_updates_cache_and_releases
      kind: transition
      expression:
        kind: transition
        rule: grant
        operand: (and (eq (read grant_valid) True) (and (eq (read grant_core) (prev
          pending_core)) (and (eq (read grant_write) (prev pending_write)) (and (eq
          (read grant_addr) (prev pending_addr)) (and (eq (read c0_state) (ite (eq
          (prev pending_core) False) (ite (prev pending_write) 3 1) (prev c0_state)))
          (and (eq (read c0_addr) (ite (eq (prev pending_core) False) (prev pending_addr)
          (prev c0_addr))) (and (eq (read c1_state) (ite (eq (prev pending_core) True)
          (ite (prev pending_write) 3 1) (prev c1_state))) (and (eq (read c1_addr)
          (ite (eq (prev pending_core) True) (prev pending_addr) (prev c1_addr)))
          (and (eq (read pending) False) (and (eq (read snooped) False) (eq (read
          req_credits) (add (prev req_credits) 1))))))))))))
    - name: grant_deasserts_when_idle
      kind: transition
      expression:
        kind: transition
        rule: clear_grant
        operand: (eq (read grant_valid) False)
  proof_obligations:
    - property: request_accepts_and_snoops
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: snoop_response_updates_peer_state
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: grant_updates_cache_and_releases
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: grant_deasserts_when_idle
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: has_line_holds_line
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
  invariants:
    - name: single_writer
      operand: (not (and (and (is_modified (read c0_state)) (is_modified (read c1_state)))
        (eq (read c0_addr) (read c1_addr))))
    - name: credits_bounded
      operand: (and (ge (read req_credits) 0) (le (read req_credits) 2))
