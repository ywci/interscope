isir_version: "0.1"
module:
  name: saturating_adder
  clocks:
    - name: clk
      edge: posedge
  resets:
    - name: rst
      polarity: active_high
      async: false
      affects: all
  inputs:
    - name: x
      direction: input
      type: "bits<8>"
    - name: y
      direction: input
      type: "bits<8>"
  outputs:
    - name: result
      direction: output
      type: "bits<8>"
    - name: overflow
      direction: output
      type: "bool"
  state:
    - name: result
      kind: register
      type: "bits<8>"
      initial: 0
    - name: overflow
      kind: register
      type: "bool"
      initial: false
  functions:
    - name: saturate
      params:
        - name: sum
          type: "bits<8>"
        - name: cap
          type: "bits<8>"
      return: "bits<8>"
      body: (ite (ge sum (add cap 1)) cap sum)
  rules:
    - name: add
      condition: "true"
      action:
        - (write result (ite (ge (add x y) 256) 255 (add x y)))
        - (write overflow (ge (add x y) 256))
  properties:
    - name: result_le_cap
      kind: safety
      expression:
        kind: always
        operand: (le result 255)
    - name: result_is_min
      kind: transition
      expression:
        kind: transition
        rule: add
        operand: (and (eq result (saturate (add x y) 255)) (eq overflow (ge (add x
          y) 256)))
  proof_obligations:
    - property: result_is_min
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: result_le_cap
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: result_le_cap
      engine: model_checking
