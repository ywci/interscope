isir_version: "0.1"
module:
  name: l1_cache_comp
  parameters:
    - name: me
      type: int
      default: 0
  clocks:
    - name: clk
      edge: posedge
  resets:
    - name: rst
      polarity: active_high
      async: false
      affects: all
  inputs:
    - name: req_core
      direction: input
      type: "bits<4>"
    - name: req_write
      direction: input
      type: "bool"
    - name: req_addr
      direction: input
      type: "bits<4>"
    - name: req_vpn
      direction: input
      type: "bits<2>"
    - name: is_physical
      direction: input
      type: "bool"
    - name: req_data
      direction: input
      type: "bits<8>"
  components: []
  state:
    - name: s0
      kind: register
      type: "bits<2>"
      initial: 0
    - name: a0
      kind: register
      type: "bits<4>"
      initial: 0
    - name: s1
      kind: register
      type: "bits<2>"
      initial: 0
    - name: a1
      kind: register
      type: "bits<4>"
      initial: 0
    - name: lru
      kind: register
      type: "bool"
      initial: false
    - name: data0
      kind: register
      type: "bits<8>"
      initial: 0
    - name: data1
      kind: register
      type: "bits<8>"
      initial: 0
    - name: rdata
      kind: register
      type: "bits<8>"
      initial: 0
  functions:
    - name: has_line
      params:
        - name: s
          type: "bits<2>"
        - name: a
          type: "bits<4>"
        - name: ra
          type: "bits<4>"
      return: "bool"
      body: (and (neq s 0) (eq a ra))
    - name: is_modified
      params:
        - name: s
          type: "bits<2>"
      return: "bool"
      body: (eq s 3)
    - name: phys_index
      params:
        - name: a
          type: "bits<4>"
      return: "bits<2>"
      body: (slice a 1 0)
  rules:
    - name: write_hit0
      condition: (and (and (eq req_core $me) req_write) (has_line (read s0) (read
        a0) req_addr))
      action:
        - (write s0 3)
        - (write data0 req_data)
        - (write lru true)
    - name: write_hit1
      condition: (and (and (and (eq req_core $me) req_write) (not (has_line (read
        s0) (read a0) req_addr))) (has_line (read s1) (read a1) req_addr))
      action:
        - (write s1 3)
        - (write data1 req_data)
        - (write lru false)
    - name: write_miss0
      condition: (and (and (and (and (eq req_core $me) req_write) (not (has_line (read
        s0) (read a0) req_addr))) (not (has_line (read s1) (read a1) req_addr))) (not
        (read lru)))
      action:
        - (write s0 3)
        - (write a0 req_addr)
        - (write data0 req_data)
        - (write lru true)
    - name: write_miss1
      condition: (and (and (and (and (eq req_core $me) req_write) (not (has_line (read
        s0) (read a0) req_addr))) (not (has_line (read s1) (read a1) req_addr))) (read
        lru))
      action:
        - (write s1 3)
        - (write a1 req_addr)
        - (write data1 req_data)
        - (write lru false)
    - name: read_hit0
      condition: (and (and (eq req_core $me) (not req_write)) (has_line (read s0)
        (read a0) req_addr))
      action:
        - (write rdata (read data0))
        - (write lru true)
    - name: read_hit1
      condition: (and (and (and (eq req_core $me) (not req_write)) (not (has_line
        (read s0) (read a0) req_addr))) (has_line (read s1) (read a1) req_addr))
      action:
        - (write rdata (read data1))
        - (write lru false)
    - name: read_miss0
      condition: (and (and (and (and (eq req_core $me) (not req_write)) (not (has_line
        (read s0) (read a0) req_addr))) (not (has_line (read s1) (read a1) req_addr)))
        (not (read lru)))
      action:
        - (write s0 1)
        - (write a0 req_addr)
    - name: read_miss1
      condition: (and (and (and (and (eq req_core $me) (not req_write)) (not (has_line
        (read s0) (read a0) req_addr))) (not (has_line (read s1) (read a1) req_addr)))
        (read lru))
      action:
        - (write s1 1)
        - (write a1 req_addr)
    - name: snoop_inv0
      condition: (and (and (neq req_core $me) req_write) (has_line (read s0) (read
        a0) req_addr))
      action:
        - (write s0 0)
    - name: snoop_inv1
      condition: (and (and (neq req_core $me) req_write) (has_line (read s1) (read
        a1) req_addr))
      action:
        - (write s1 0)
    - name: snoop_dg0
      condition: (and (and (neq req_core $me) (not req_write)) (has_line (read s0)
        (read a0) req_addr))
      action:
        - (write s0 1)
    - name: snoop_dg1
      condition: (and (and (neq req_core $me) (not req_write)) (has_line (read s1)
        (read a1) req_addr))
      action:
        - (write s1 1)
  properties:
    - name: states_valid
      kind: safety
      expression:
        kind: always
        operand: (and (and (ge (read s0) 0) (le (read s0) 3)) (and (ge (read s1) 0)
          (le (read s1) 3)))
    - name: physical_tag_used
      kind: transition
      expression:
        kind: transition
        rule: write_miss0
        operand: (eq (read a0) req_addr)
    - name: modified_way_holds_line
      kind: safety
      expression:
        kind: always
        operand: (implies (is_modified (read s0)) (has_line (read s0) (read a0) (read
          a0)))
  proof_obligations:
    - property: physical_tag_used
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: states_valid
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: modified_way_holds_line
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
