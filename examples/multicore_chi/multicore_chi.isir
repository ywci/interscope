isir_version: "0.1"
module:
  name: multicore_chi
  clocks:
    - name: clk
      edge: posedge
  resets:
    - name: rst
      polarity: active_high
      async: false
      affects: all
  inputs:
    - name: req_core
      direction: input
      type: "bool"
    - name: req_write
      direction: input
      type: "bool"
    - name: req_addr
      direction: input
      type: "bits<4>"
    - name: req_data
      direction: input
      type: "bits<8>"
  components:
    # Request nodes: their L1D MESI state is the real cache.
    - name: rn0
      module: "examples/rn_core/rn_core.isir"
      lift_properties: false
      port_map: {req_core: false, mstate: c0_mstate_signal, maddr: c0_maddr_signal}
    - name: rn1
      module: "examples/rn_core/rn_core.isir"
      lift_properties: false
      port_map: {req_core: true, mstate: c1_mstate_signal, maddr: c1_maddr_signal}
    # Home node: directory + centralized snoop, writing the RNs' L1D via cross-instance.
    - name: home
      module: "examples/home/home.isir"
      lift_properties: false
      port_map: {req_core: req_core, req_write: req_write, req_addr: req_addr, req_data: req_data,
                 c0_state: c0_mstate_signal, c0_addr: c0_maddr_signal,
                 c1_state: c1_mstate_signal, c1_addr: c1_maddr_signal}
  state:
    # Shared signals carrying the RNs' L1D MESI state.
    - name: c0_mstate_signal
      kind: register
      type: "bits<2>"
      initial: 0
    - name: c0_maddr_signal
      kind: register
      type: "bits<4>"
      initial: 0
    - name: c1_mstate_signal
      kind: register
      type: "bits<2>"
      initial: 0
    - name: c1_maddr_signal
      kind: register
      type: "bits<4>"
      initial: 0
  functions:
    - name: is_modified
      params: [{name: s, type: "bits<2>"}]
      return: "bool"
      body: (eq s 3)
    - name: is_exclusive
      params: [{name: s, type: "bits<2>"}]
      return: "bool"
      body: (eq s 2)
    - name: has_line
      params: [{name: s, type: "bits<2>"}, {name: a, type: "bits<4>"}, {name: ra, type: "bits<4>"}]
      return: "bool"
      body: (and (neq s 0) (eq a ra))
  invariants:
    - name: single_writer
      operand: (not (and (and (is_modified (read c0_mstate_signal)) (is_modified (read c1_mstate_signal)))
                        (eq (read c0_maddr_signal) (read c1_maddr_signal))))
    - name: m_exclusive
      operand: (and
                 (not (and (is_modified (read c0_mstate_signal)) (has_line (read c1_mstate_signal) (read c1_maddr_signal) (read c0_maddr_signal))))
                 (not (and (is_modified (read c1_mstate_signal)) (has_line (read c0_mstate_signal) (read c0_maddr_signal) (read c1_maddr_signal)))))
    - name: e_exclusive
      operand: (and
                 (not (and (is_exclusive (read c0_mstate_signal)) (has_line (read c1_mstate_signal) (read c1_maddr_signal) (read c0_maddr_signal))))
                 (not (and (is_exclusive (read c1_mstate_signal)) (has_line (read c0_mstate_signal) (read c0_maddr_signal) (read c1_maddr_signal)))))

  properties:
    - name: __none__
      kind: safety
      expression:
        kind: always
        operand: "true"
      kind: safety
      expression:
        kind: always
        operand: (not (and (and (is_modified (read c0_mstate_signal)) (is_modified (read c1_mstate_signal)))
                          (eq (read c0_maddr_signal) (read c1_maddr_signal))))
    - name: m_exclusive
      kind: safety
      expression:
        kind: always
        operand: (and
                   (not (and (is_modified (read c0_mstate_signal)) (has_line (read c1_mstate_signal) (read c1_maddr_signal) (read c0_maddr_signal))))
                   (not (and (is_modified (read c1_mstate_signal)) (has_line (read c0_mstate_signal) (read c0_maddr_signal) (read c1_maddr_signal)))))
    - name: e_exclusive
      kind: safety
      expression:
        kind: always
        operand: (and
                   (not (and (is_exclusive (read c0_mstate_signal)) (has_line (read c1_mstate_signal) (read c1_maddr_signal) (read c0_maddr_signal))))
                   (not (and (is_exclusive (read c1_mstate_signal)) (has_line (read c0_mstate_signal) (read c0_maddr_signal) (read c1_maddr_signal)))))
  proof_obligations:
    - property: single_writer
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: m_exclusive
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: e_exclusive
      status: unproved
      engine: theorem_proving
      backend: koika
