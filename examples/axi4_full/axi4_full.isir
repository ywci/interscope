isir_version: "0.1"
module:
  name: axi4_full
  clocks:
    - name: clk
      edge: posedge
  resets:
    - name: rst
      polarity: active_high
      async: false
      affects: all
  inputs:
    - name: awaddr_in
      direction: input
      type: "bits<8>"
    - name: awlen_in
      direction: input
      type: "bits<8>"
    - name: awvalid
      direction: input
      type: "bool"
    - name: awready
      direction: input
      type: "bool"
    - name: wdata
      direction: input
      type: "bits<32>"
    - name: wvalid
      direction: input
      type: "bool"
    - name: wready
      direction: input
      type: "bool"
    - name: bready
      direction: input
      type: "bool"
  outputs:
    - name: bvalid
      direction: output
      type: "bool"
  state:
    - name: awaddr
      kind: register
      type: "bits<8>"
      initial: 0
    - name: awlen
      kind: register
      type: "bits<8>"
      initial: 0
    - name: waddr
      kind: register
      type: "bits<8>"
      initial: 0
    - name: wcount
      kind: register
      type: "bits<8>"
      initial: 0
    - name: bvalid
      kind: register
      type: "bool"
      initial: false
    - name: mem
      kind: memory
      type:
        type: memory
        elem: "bits<32>"
        depth: 16
  rules:
    - name: aw
      condition: (and awvalid awready)
      action:
        - (write awaddr awaddr_in)
        - (write awlen awlen_in)
        - (write waddr awaddr_in)
        - (write wcount 0)
    - name: w
      condition: (and (and wvalid wready) (lt (read wcount) (read awlen)))
      action:
        - (mem_write mem (slice (read waddr) 5 2) wdata)
        - (write waddr (add (read waddr) 4))
        - (write wcount (add (read wcount) 1))
    - name: b
      condition: (eq (read wcount) (read awlen))
      action:
        - (write bvalid true)
    - name: b_clear
      condition: (and (read bvalid) bready)
      action:
        - (write bvalid false)
  properties:
    - name: waddr_increments_on_beat
      kind: transition
      expression:
        kind: transition
        rule: w
        operand: (eq (read waddr) (add (prev waddr) 4))
    - name: wcount_increments_on_beat
      kind: transition
      expression:
        kind: transition
        rule: w
        operand: (eq (read wcount) (add (prev wcount) 1))
    - name: response_after_burst
      kind: transition
      expression:
        kind: transition
        rule: b
        operand: (eq (prev wcount) (prev awlen))
    - name: wcount_bounded_by_len
      kind: safety
      expression:
        kind: always
        operand: (le (read wcount) (read awlen))
  proof_obligations:
    - property: waddr_increments_on_beat
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: wcount_increments_on_beat
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: response_after_burst
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: wcount_bounded_by_len
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
