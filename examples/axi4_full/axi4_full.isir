isir_version: "0.1"
module:
  name: axi4_full
  clocks:
    - name: clk
      edge: posedge
  resets:
    - name: rst
      polarity: active_high
      async: false
      affects: all
  inputs:
    # Write address channel (with burst length).
    - name: awaddr_in
      direction: input
      type: "bits<8>"
    - name: awlen_in
      direction: input
      type: "bits<8>"
    - name: awvalid
      direction: input
      type: "bool"
    - name: awready
      direction: input
      type: "bool"
    # Write data channel.
    - name: wdata
      direction: input
      type: "bits<32>"
    - name: wvalid
      direction: input
      type: "bool"
    - name: wready
      direction: input
      type: "bool"
    # Write response channel.
    - name: bready
      direction: input
      type: "bool"
  outputs:
    - name: bvalid
      direction: output
      type: "bool"
  state:
    # Latched write-address channel state.
    - name: awaddr
      kind: register
      type: "bits<8>"
      initial: 0
    - name: awlen
      kind: register
      type: "bits<8>"
      initial: 0
    # Current burst address and beat counter.
    - name: waddr
      kind: register
      type: "bits<8>"
      initial: 0
    - name: wcount
      kind: register
      type: "bits<8>"
      initial: 0
    # Write response valid.
    - name: bvalid
      kind: register
      type: "bool"
      initial: false
    # Slave memory (16 words of 32 bits).
    - name: mem
      kind: memory
      type: { type: "memory", elem: "bits<32>", depth: 16 }

  rules:
    # AW handshake: latch the burst address and length, restart the burst.
    - name: aw
      condition: (and awvalid awready)
      action:
        - (write awaddr awaddr_in)
        - (write awlen awlen_in)
        - (write waddr awaddr_in)
        - (write wcount 0)
    # W beat: write the data word and advance the INCR burst.
    - name: w
      condition: (and (and wvalid wready) (lt (read wcount) (read awlen)))
      action:
        - (mem_write mem (read waddr) wdata)
        - (write waddr (add (read waddr) 4))
        - (write wcount (add (read wcount) 1))
    # B response: after the burst completes, set the response.
    - name: b
      condition: (eq (read wcount) (read awlen))
      action:
        - (write bvalid true)
    # B handshake clears the response.
    - name: b_clear
      condition: (and (read bvalid) bready)
      action:
        - (write bvalid false)

  properties:
    - name: waddr_increments_on_beat
      kind: transition
      expression:
        kind: transition
        rule: w
        operand: (eq (read waddr) (add (prev waddr) 4))
    - name: wcount_increments_on_beat
      kind: transition
      expression:
        kind: transition
        rule: w
        operand: (eq (read wcount) (add (prev wcount) 1))
    - name: response_after_burst
      kind: transition
      expression:
        kind: transition
        rule: b
        operand: (eq (prev wcount) (prev awlen))
    - name: wcount_bounded_by_len
      kind: safety
      expression:
        kind: always
        operand: (le (read wcount) (read awlen))

  proof_obligations:
    - property: waddr_increments_on_beat
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: wcount_increments_on_beat
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: response_after_burst
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: wcount_bounded_by_len
      status: unproved
      engine: theorem_proving
      backend: koika
