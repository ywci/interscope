isir_version: "0.1"
module:
  name: microcode_controller
  clocks:
    - name: clk
      edge: posedge
      period: "10ns"
  resets:
    - name: rst_n
      polarity: active_low
      async: false
      affects: all
  inputs:
    - name: start
      direction: input
      type: "bool"
    - name: all_idle
      direction: input
      type: "bool"
    - name: ucode_opcode
      direction: input
      type: "bits<3>"
  state:
    - name: pc
      kind: register
      type: "bits<4>"
      initial: 0
    - name: running
      kind: register
      type: "bool"
      initial: false
    - name: opcode_out
      kind: register
      type: "bits<3>"
      initial: 0
  rules:
    - name: start_fetch
      condition: (and start (not (read running)))
      action:
        - (write running true)
        - (write pc 0)
    - name: decode
      condition: (read running)
      action:
        - (write opcode_out ucode_opcode)
    - name: advance
      condition: (and (read running) all_idle)
      action:
        - (write pc (min (add (read pc) 1) 15))
    - name: finish
      condition: (and (read running) (eq (read pc) 15))
      action:
        - (write running false)
  properties:
    - name: running_iff_program_active
      kind: safety
      expression:
        kind: always
        operand: (eq (read running) (lt (read pc) 15))
    - name: fetch_starts
      kind: transition
      expression:
        kind: transition
        rule: start_fetch
        operand: (and (eq (read running) True) (eq (read pc) 0))
    - name: opcode_decoded
      kind: transition
      expression:
        kind: transition
        rule: decode
        operand: (eq (read opcode_out) ucode_opcode)
    - name: pc_increments
      kind: transition
      expression:
        kind: transition
        rule: advance
        operand: (eq (read pc) (min (add (prev pc) 1) 15))
    - name: program_finishes
      kind: transition
      expression:
        kind: transition
        rule: finish
        operand: (eq (read running) False)
  proof_obligations:
    - property: fetch_starts
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: opcode_decoded
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: pc_increments
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: program_finishes
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: running_iff_program_active
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
