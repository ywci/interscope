isir_version: "0.1"
module:
  name: riscv_ooo_cache
  clocks:
    - name: clk
      edge: posedge
  resets:
    - name: rst
      polarity: active_high
      async: false
      affects: all
  inputs:
    - name: rdata
      direction: input
      type: "bits<32>"
    - name: rvalid
      direction: input
      type: "bool"
    - name: arready
      direction: input
      type: "bool"
    - name: store_addr
      direction: input
      type: "bits<32>"
    - name: store_data
      direction: input
      type: "bits<32>"
    - name: store_valid
      direction: input
      type: "bool"
    - name: load_addr
      direction: input
      type: "bits<32>"
    - name: load_valid
      direction: input
      type: "bool"
    - name: bvalid
      direction: input
      type: "bool"
    - name: load_rdata
      direction: input
      type: "bits<32>"
    - name: load_rvalid
      direction: input
      type: "bool"
    - name: ppn_in
      direction: input
      type: "bits<20>"
  outputs:
    - name: result
      direction: output
      type: "bits<32>"
  state:
    - name: rob0_instr
      kind: register
      type: "bits<32>"
      initial: 0
    - name: rob0_valid
      kind: register
      type: "bool"
      initial: false
    - name: rob0_done
      kind: register
      type: "bool"
      initial: false
    - name: rob1_instr
      kind: register
      type: "bits<32>"
      initial: 0
    - name: rob1_valid
      kind: register
      type: "bool"
      initial: false
    - name: rob1_done
      kind: register
      type: "bool"
      initial: false
    - name: rob0_data
      kind: register
      type: "bits<32>"
      initial: 0
    - name: rob0_store
      kind: register
      type: "bool"
      initial: false
    - name: rob1_data
      kind: register
      type: "bits<32>"
      initial: 0
    - name: rob1_store
      kind: register
      type: "bool"
      initial: false
    - name: rob0_load
      kind: register
      type: "bool"
      initial: false
    - name: rob1_load
      kind: register
      type: "bool"
      initial: false
    - name: head
      kind: register
      type: "bool"
      initial: false
    - name: tail
      kind: register
      type: "bool"
      initial: false
    - name: arch
      kind: register
      type: "bits<32>"
      initial: 0
    - name: PC
      kind: register
      type: "bits<32>"
      initial: 0
    - name: ctr
      kind: register
      type: "bits<2>"
      initial: 0
    - name: flush
      kind: register
      type: "bool"
      initial: false
    - name: ic_v0
      kind: register
      type: "bool"
      initial: false
    - name: ic_t0
      kind: register
      type: "bits<20>"
      initial: 0
    - name: ic_d0
      kind: register
      type: "bits<32>"
      initial: 0
    - name: ic_v1
      kind: register
      type: "bool"
      initial: false
    - name: ic_t1
      kind: register
      type: "bits<20>"
      initial: 0
    - name: ic_d1
      kind: register
      type: "bits<32>"
      initial: 0
    - name: ic_lru
      kind: register
      type: "bool"
      initial: false
    - name: l2_v0
      kind: register
      type: "bool"
      initial: false
    - name: l2_t0
      kind: register
      type: "bits<20>"
      initial: 0
    - name: l2_d0
      kind: register
      type: "bits<32>"
      initial: 0
    - name: l2_v1
      kind: register
      type: "bool"
      initial: false
    - name: l2_t1
      kind: register
      type: "bits<20>"
      initial: 0
    - name: l2_d1
      kind: register
      type: "bits<32>"
      initial: 0
    - name: l2_lru
      kind: register
      type: "bool"
      initial: false
    - name: araddr
      kind: register
      type: "bits<32>"
      initial: 0
    - name: arvalid
      kind: register
      type: "bool"
      initial: false
    - name: awaddr
      kind: register
      type: "bits<32>"
      initial: 0
    - name: awvalid
      kind: register
      type: "bool"
      initial: false
    - name: wdata
      kind: register
      type: "bits<32>"
      initial: 0
    - name: wvalid
      kind: register
      type: "bool"
      initial: false
    - name: load_araddr
      kind: register
      type: "bits<32>"
      initial: 0
    - name: load_arvalid
      kind: register
      type: "bool"
      initial: false
    - name: load_result
      kind: register
      type: "bits<32>"
      initial: 0
    - name: load_rob0
      kind: register
      type: "bool"
      initial: false
    - name: dc_v0
      kind: register
      type: "bool"
      initial: false
    - name: dc_t0
      kind: register
      type: "bits<20>"
      initial: 0
    - name: dc_d0
      kind: register
      type: "bits<32>"
      initial: 0
    - name: dc_v1
      kind: register
      type: "bool"
      initial: false
    - name: dc_t1
      kind: register
      type: "bits<20>"
      initial: 0
    - name: dc_d1
      kind: register
      type: "bits<32>"
      initial: 0
    - name: dc_lru
      kind: register
      type: "bool"
      initial: false
    - name: tlb0_vpn
      kind: register
      type: "bits<20>"
      initial: 0
    - name: tlb0_ppn
      kind: register
      type: "bits<20>"
      initial: 0
    - name: tlb0_valid
      kind: register
      type: "bool"
      initial: false
    - name: tlb1_vpn
      kind: register
      type: "bits<20>"
      initial: 0
    - name: tlb1_ppn
      kind: register
      type: "bits<20>"
      initial: 0
    - name: tlb1_valid
      kind: register
      type: "bool"
      initial: false
    - name: tlb_lru
      kind: register
      type: "bool"
      initial: false
    - name: tlb_ppn
      kind: register
      type: "bits<20>"
      initial: 0
  functions:
    - name: vpn
      params:
        - name: va
          type: "bits<32>"
      return: "bits<20>"
      body: (slice va 31 12)
    - name: offset
      params:
        - name: va
          type: "bits<32>"
      return: "bits<12>"
      body: (slice va 11 0)
    - name: translate
      params:
        - name: va
          type: "bits<32>"
        - name: ppn
          type: "bits<20>"
      return: "bits<32>"
      body: (concat ppn (offset va) 12)
    - name: way_hit
      params:
        - name: v
          type: "bool"
        - name: t
          type: "bits<20>"
        - name: ppn
          type: "bits<20>"
      return: "bool"
      body: (and v (eq t ppn))
    - name: set_hit
      params:
        - name: v0
          type: "bool"
        - name: t0
          type: "bits<20>"
        - name: v1
          type: "bool"
        - name: t1
          type: "bits<20>"
        - name: ppn
          type: "bits<20>"
      return: "bool"
      body: (or (way_hit v0 t0 ppn) (way_hit v1 t1 ppn))
    - name: fetch_instr
      params:
        - name: v0
          type: "bool"
        - name: t0
          type: "bits<20>"
        - name: d0
          type: "bits<32>"
        - name: v1
          type: "bool"
        - name: t1
          type: "bits<20>"
        - name: d1
          type: "bits<32>"
        - name: ppn
          type: "bits<20>"
      return: "bits<32>"
      body: (ite (way_hit v0 t0 ppn) d0 d1)
    - name: is_branch
      params:
        - name: i
          type: "bits<32>"
      return: "bool"
      body: (eq (slice i 6 0) 0b1100011)
    - name: branch_target
      params:
        - name: i
          type: "bits<32>"
        - name: pc
          type: "bits<32>"
      return: "bits<32>"
      body: (add pc (mul (slice i 31 20) 4))
    - name: predict_taken
      params:
        - name: i
          type: "bits<32>"
        - name: c
          type: "bits<2>"
      return: "bool"
      body: (ge c 2)
    - name: actual_taken
      params:
        - name: i
          type: "bits<32>"
      return: "bool"
      body: (eq (slice i 14 12) 0)
    - name: mispredicted
      params:
        - name: i
          type: "bits<32>"
        - name: c
          type: "bits<2>"
      return: "bool"
      body: (and (is_branch i) (neq (predict_taken i c) (actual_taken i)))
    - name: store_load_alias
      params:
        - name: la
          type: "bits<32>"
        - name: sa
          type: "bits<32>"
        - name: sv
          type: "bool"
      return: "bool"
      body: (and sv (eq la sa))
  rules:
    - name: tlb_fill
      condition: (not (set_hit (read tlb0_valid) (read tlb0_vpn) (read tlb1_valid)
        (read tlb1_vpn) (vpn (read PC))))
      action:
        - (write tlb0_vpn (ite (read tlb_lru) (vpn (read PC)) (read tlb0_vpn)))
        - (write tlb0_ppn (ite (read tlb_lru) ppn_in (read tlb0_ppn)))
        - (write tlb0_valid (ite (read tlb_lru) true (read tlb0_valid)))
        - (write tlb1_vpn (ite (not (read tlb_lru)) (vpn (read PC)) (read tlb1_vpn)))
        - (write tlb1_ppn (ite (not (read tlb_lru)) ppn_in (read tlb1_ppn)))
        - (write tlb1_valid (ite (not (read tlb_lru)) true (read tlb1_valid)))
        - (write tlb_lru (not (read tlb_lru)))
        - (write tlb_ppn ppn_in)
    - name: tlb_hit
      condition: (set_hit (read tlb0_valid) (read tlb0_vpn) (read tlb1_valid) (read
        tlb1_vpn) (vpn (read PC)))
      action:
        - (write tlb_ppn (ite (way_hit (read tlb0_valid) (read tlb0_vpn) (vpn (read
          PC))) (read tlb0_ppn) (read tlb1_ppn)))
        - (write tlb_lru (ite (way_hit (read tlb0_valid) (read tlb0_vpn) (vpn (read
          PC))) false true))
    - name: fetch
      condition: (and (and (not (set_hit (read ic_v0) (read ic_t0) (read ic_v1) (read
        ic_t1) (read tlb_ppn))) (not (set_hit (read l2_v0) (read l2_t0) (read l2_v1)
        (read l2_t1) (read tlb_ppn)))) (not (read arvalid)))
      action:
        - (write arvalid true)
        - (write araddr (translate (read PC) (read tlb_ppn)))
    - name: mem_response
      condition: (and (read arvalid) rvalid)
      action:
        - (write l2_v0 (ite (read l2_lru) true (read l2_v0)))
        - (write l2_t0 (ite (read l2_lru) (vpn (read araddr)) (read l2_t0)))
        - (write l2_d0 (ite (read l2_lru) rdata (read l2_d0)))
        - (write l2_v1 (ite (not (read l2_lru)) true (read l2_v1)))
        - (write l2_t1 (ite (not (read l2_lru)) (vpn (read araddr)) (read l2_t1)))
        - (write l2_d1 (ite (not (read l2_lru)) rdata (read l2_d1)))
        - (write l2_lru (not (read l2_lru)))
        - (write arvalid false)
    - name: store_issue0
      condition: (and (and store_valid (not (read tail))) (not (read flush)))
      action:
        - (write rob0_instr store_addr)
        - (write rob0_data store_data)
        - (write rob0_store true)
        - (write rob0_load false)
        - (write rob0_valid true)
        - (write rob0_done false)
        - (write tail true)
    - name: store_issue1
      condition: (and (and store_valid (read tail)) (not (read flush)))
      action:
        - (write rob1_instr store_addr)
        - (write rob1_data store_data)
        - (write rob1_store true)
        - (write rob1_load false)
        - (write rob1_valid true)
        - (write rob1_done false)
        - (write tail false)
    - name: load_issue0
      condition: (and (and load_valid (not (read tail))) (not (read flush)))
      action:
        - (write rob0_instr load_addr)
        - (write rob0_data 0)
        - (write rob0_store false)
        - (write rob0_load true)
        - (write rob0_valid true)
        - (write rob0_done false)
        - (write tail true)
    - name: load_issue1
      condition: (and (and load_valid (read tail)) (not (read flush)))
      action:
        - (write rob1_instr load_addr)
        - (write rob1_data 0)
        - (write rob1_store false)
        - (write rob1_load true)
        - (write rob1_valid true)
        - (write rob1_done false)
        - (write tail false)
    - name: write_response
      condition: (and bvalid (read awvalid))
      action:
        - (write awvalid false)
        - (write wvalid false)
    - name: load_response
      condition: (and (read load_arvalid) load_rvalid)
      action:
        - (write rob0_data (ite (read load_rob0) load_rdata (read rob0_data)))
        - (write rob0_done (ite (read load_rob0) true (read rob0_done)))
        - (write rob1_data (ite (not (read load_rob0)) load_rdata (read rob1_data)))
        - (write rob1_done (ite (not (read load_rob0)) true (read rob1_done)))
        - (write dc_v0 (ite (read dc_lru) true (read dc_v0)))
        - (write dc_t0 (ite (read dc_lru) (vpn (read load_araddr)) (read dc_t0)))
        - (write dc_d0 (ite (read dc_lru) load_rdata (read dc_d0)))
        - (write dc_v1 (ite (not (read dc_lru)) true (read dc_v1)))
        - (write dc_t1 (ite (not (read dc_lru)) (vpn (read load_araddr)) (read dc_t1)))
        - (write dc_d1 (ite (not (read dc_lru)) load_rdata (read dc_d1)))
        - (write dc_lru (not (read dc_lru)))
        - (write load_arvalid false)
    - name: fill_l1
      condition: (and (not (set_hit (read ic_v0) (read ic_t0) (read ic_v1) (read ic_t1)
        (read tlb_ppn))) (set_hit (read l2_v0) (read l2_t0) (read l2_v1) (read l2_t1)
        (read tlb_ppn)))
      action:
        - (write ic_v0 (ite (read ic_lru) true (read ic_v0)))
        - (write ic_t0 (ite (read ic_lru) (read tlb_ppn) (read ic_t0)))
        - (write ic_d0 (ite (read ic_lru) (fetch_instr (read l2_v0) (read l2_t0) (read
          l2_d0) (read l2_v1) (read l2_t1) (read l2_d1) (read tlb_ppn)) (read ic_d0)))
        - (write ic_v1 (ite (not (read ic_lru)) true (read ic_v1)))
        - (write ic_t1 (ite (not (read ic_lru)) (read tlb_ppn) (read ic_t1)))
        - (write ic_d1 (ite (not (read ic_lru)) (fetch_instr (read l2_v0) (read l2_t0)
          (read l2_d0) (read l2_v1) (read l2_t1) (read l2_d1) (read tlb_ppn)) (read
          ic_d1)))
        - (write ic_lru (not (read ic_lru)))
    - name: issue0
      condition: (and (and (set_hit (read ic_v0) (read ic_t0) (read ic_v1) (read ic_t1)
        (read tlb_ppn)) (not (read tail))) (not (read flush)))
      action:
        - (write rob0_instr (fetch_instr (read ic_v0) (read ic_t0) (read ic_d0) (read
          ic_v1) (read ic_t1) (read ic_d1) (read tlb_ppn)))
        - (write rob0_data 0)
        - (write rob0_store false)
        - (write rob0_load false)
        - (write rob0_valid true)
        - (write rob0_done false)
        - (write tail true)
        - (write ic_lru (ite (way_hit (read ic_v0) (read ic_t0) (read tlb_ppn)) false
          true))
        - (write PC (ite (and (is_branch (fetch_instr (read ic_v0) (read ic_t0) (read
          ic_d0) (read ic_v1) (read ic_t1) (read ic_d1) (read tlb_ppn))) (predict_taken
          (fetch_instr (read ic_v0) (read ic_t0) (read ic_d0) (read ic_v1) (read ic_t1)
          (read ic_d1) (read tlb_ppn)) (read ctr))) (branch_target (fetch_instr (read
          ic_v0) (read ic_t0) (read ic_d0) (read ic_v1) (read ic_t1) (read ic_d1)
          (read tlb_ppn)) (read PC)) (add (read PC) 4)))
    - name: issue1
      condition: (and (and (set_hit (read ic_v0) (read ic_t0) (read ic_v1) (read ic_t1)
        (read tlb_ppn)) (read tail)) (not (read flush)))
      action:
        - (write rob1_instr (fetch_instr (read ic_v0) (read ic_t0) (read ic_d0) (read
          ic_v1) (read ic_t1) (read ic_d1) (read tlb_ppn)))
        - (write rob1_data 0)
        - (write rob1_store false)
        - (write rob1_load false)
        - (write rob1_valid true)
        - (write rob1_done false)
        - (write tail false)
        - (write ic_lru (ite (way_hit (read ic_v0) (read ic_t0) (read tlb_ppn)) false
          true))
        - (write PC (ite (and (is_branch (fetch_instr (read ic_v0) (read ic_t0) (read
          ic_d0) (read ic_v1) (read ic_t1) (read ic_d1) (read tlb_ppn))) (predict_taken
          (fetch_instr (read ic_v0) (read ic_t0) (read ic_d0) (read ic_v1) (read ic_t1)
          (read ic_d1) (read tlb_ppn)) (read ctr))) (branch_target (fetch_instr (read
          ic_v0) (read ic_t0) (read ic_d0) (read ic_v1) (read ic_t1) (read ic_d1)
          (read tlb_ppn)) (read PC)) (add (read PC) 4)))
    - name: exec0
      condition: (and (and (read rob0_valid) (not (read rob0_done))) (not (read rob0_load)))
      action:
        - (write rob0_done true)
    - name: exec1
      condition: (and (and (read rob1_valid) (not (read rob1_done))) (not (read rob1_load)))
      action:
        - (write rob1_done true)
    - name: load_hit0
      condition: (and (and (and (read rob0_valid) (not (read rob0_done))) (read rob0_load))
        (and (set_hit (read dc_v0) (read dc_t0) (read dc_v1) (read dc_t1) (vpn (read
        rob0_instr))) (not (and (read head) (store_load_alias (read rob0_instr) (read
        rob1_instr) (read rob1_store))))))
      action:
        - (write rob0_data (fetch_instr (read dc_v0) (read dc_t0) (read dc_d0) (read
          dc_v1) (read dc_t1) (read dc_d1) (vpn (read rob0_instr))))
        - (write rob0_done true)
        - (write dc_lru (ite (way_hit (read dc_v0) (read dc_t0) (vpn (read rob0_instr)))
          false true))
    - name: load_hit1
      condition: (and (and (and (read rob1_valid) (not (read rob1_done))) (read rob1_load))
        (and (set_hit (read dc_v0) (read dc_t0) (read dc_v1) (read dc_t1) (vpn (read
        rob1_instr))) (not (and (not (read head)) (store_load_alias (read rob1_instr)
        (read rob0_instr) (read rob0_store))))))
      action:
        - (write rob1_data (fetch_instr (read dc_v0) (read dc_t0) (read dc_d0) (read
          dc_v1) (read dc_t1) (read dc_d1) (vpn (read rob1_instr))))
        - (write rob1_done true)
        - (write dc_lru (ite (way_hit (read dc_v0) (read dc_t0) (vpn (read rob1_instr)))
          false true))
    - name: load_exec0
      condition: (and (and (and (read rob0_valid) (not (read rob0_done))) (read rob0_load))
        (and (not (read load_arvalid)) (and (not (set_hit (read dc_v0) (read dc_t0)
        (read dc_v1) (read dc_t1) (vpn (read rob0_instr)))) (not (and (read head)
        (store_load_alias (read rob0_instr) (read rob1_instr) (read rob1_store)))))))
      action:
        - (write load_arvalid true)
        - (write load_araddr (read rob0_instr))
        - (write load_rob0 true)
    - name: load_exec1
      condition: (and (and (and (read rob1_valid) (not (read rob1_done))) (read rob1_load))
        (and (not (read load_arvalid)) (and (not (set_hit (read dc_v0) (read dc_t0)
        (read dc_v1) (read dc_t1) (vpn (read rob1_instr)))) (not (and (not (read head))
        (store_load_alias (read rob1_instr) (read rob0_instr) (read rob0_store)))))))
      action:
        - (write load_arvalid true)
        - (write load_araddr (read rob1_instr))
        - (write load_rob0 false)
    - name: load_forward0
      condition: (and (and (and (read rob0_valid) (not (read rob0_done))) (read rob0_load))
        (and (read head) (store_load_alias (read rob0_instr) (read rob1_instr) (read
        rob1_store))))
      action:
        - (write rob0_data (read rob1_data))
        - (write rob0_done true)
    - name: load_forward1
      condition: (and (and (and (read rob1_valid) (not (read rob1_done))) (read rob1_load))
        (and (not (read head)) (store_load_alias (read rob1_instr) (read rob0_instr)
        (read rob0_store))))
      action:
        - (write rob1_data (read rob0_data))
        - (write rob1_done true)
    - name: commit0
      condition: (and (and (not (read head)) (read rob0_valid)) (read rob0_done))
      action:
        - (write arch (read rob0_instr))
        - (write rob0_valid false)
        - (write head true)
        - (write flush (mispredicted (read rob0_instr) (read ctr)))
        - (write ctr (ite (is_branch (read rob0_instr)) (ite (lt (read ctr) 3) (add
          (read ctr) 1) (read ctr)) (read ctr)))
        - (write awvalid (ite (read rob0_store) true (read awvalid)))
        - (write awaddr (ite (read rob0_store) (read rob0_instr) (read awaddr)))
        - (write wvalid (ite (read rob0_store) true (read wvalid)))
        - (write wdata (ite (read rob0_store) (read rob0_data) (read wdata)))
        - (write dc_d0 (ite (and (read rob0_store) (way_hit (read dc_v0) (read dc_t0)
          (vpn (read rob0_instr)))) (read rob0_data) (read dc_d0)))
        - (write dc_d1 (ite (and (read rob0_store) (way_hit (read dc_v1) (read dc_t1)
          (vpn (read rob0_instr)))) (read rob0_data) (read dc_d1)))
        - (write load_result (ite (read rob0_load) (read rob0_data) (read load_result)))
    - name: commit1
      condition: (and (and (read head) (read rob1_valid)) (read rob1_done))
      action:
        - (write arch (read rob1_instr))
        - (write rob1_valid false)
        - (write head false)
        - (write flush (mispredicted (read rob1_instr) (read ctr)))
        - (write ctr (ite (is_branch (read rob1_instr)) (ite (lt (read ctr) 3) (add
          (read ctr) 1) (read ctr)) (read ctr)))
        - (write awvalid (ite (read rob1_store) true (read awvalid)))
        - (write awaddr (ite (read rob1_store) (read rob1_instr) (read awaddr)))
        - (write wvalid (ite (read rob1_store) true (read wvalid)))
        - (write wdata (ite (read rob1_store) (read rob1_data) (read wdata)))
        - (write dc_d0 (ite (and (read rob1_store) (way_hit (read dc_v0) (read dc_t0)
          (vpn (read rob1_instr)))) (read rob1_data) (read dc_d0)))
        - (write dc_d1 (ite (and (read rob1_store) (way_hit (read dc_v1) (read dc_t1)
          (vpn (read rob1_instr)))) (read rob1_data) (read dc_d1)))
        - (write load_result (ite (read rob1_load) (read rob1_data) (read load_result)))
    - name: recover
      condition: (read flush)
      action:
        - (write flush false)
        - (write rob1_valid false)
        - (write rob0_valid (ite (read head) (read rob0_valid) false))
  properties:
    - name: ic_lru_bool
      kind: safety
      expression:
        kind: always
        operand: (or (eq (read ic_lru) True) (eq (read ic_lru) False))
    - name: l2_lru_bool
      kind: safety
      expression:
        kind: always
        operand: (or (eq (read l2_lru) True) (eq (read l2_lru) False))
    - name: tlb_lru_bool
      kind: safety
      expression:
        kind: always
        operand: (or (eq (read tlb_lru) True) (eq (read tlb_lru) False))
    - name: tlb_hit_way0_updates_lru
      kind: transition
      expression:
        kind: transition
        rule: tlb_hit
        operand: (implies (way_hit (prev tlb0_valid) (prev tlb0_vpn) (vpn (prev PC)))
          (eq (read tlb_lru) False))
    - name: tlb_miss_fills_lru_way0
      kind: transition
      expression:
        kind: transition
        rule: tlb_fill
        operand: (implies (prev tlb_lru) (eq (read tlb0_valid) True))
    - name: dc_lru_bool
      kind: safety
      expression:
        kind: always
        operand: (or (eq (read dc_lru) True) (eq (read dc_lru) False))
    - name: load_dc_hit
      kind: transition
      expression:
        kind: transition
        rule: load_hit0
        operand: (and (eq (read rob0_done) True) (eq (read rob0_data) (fetch_instr
          (prev dc_v0) (prev dc_t0) (prev dc_d0) (prev dc_v1) (prev dc_t1) (prev dc_d1)
          (vpn (prev rob0_instr)))))
    - name: load_dc_miss_fills
      kind: transition
      expression:
        kind: transition
        rule: load_response
        operand: (implies (prev dc_lru) (eq (read dc_v0) True))
    - name: store_writes_dc
      kind: transition
      expression:
        kind: transition
        rule: commit0
        operand: (implies (and (prev rob0_store) (way_hit (prev dc_v0) (prev dc_t0)
          (vpn (prev rob0_instr)))) (eq (read dc_d0) (prev rob0_data)))
    - name: fetch_sets_arvalid
      kind: transition
      expression:
        kind: transition
        rule: fetch
        operand: (eq (read arvalid) True)
    - name: fetch_sets_araddr
      kind: transition
      expression:
        kind: transition
        rule: fetch
        operand: (eq (read araddr) (translate (prev PC) (prev tlb_ppn)))
    - name: fill_l1_tags_with_ppn
      kind: transition
      expression:
        kind: transition
        rule: fill_l1
        operand: (implies (prev ic_lru) (eq (read ic_t0) (prev tlb_ppn)))
    - name: mem_response_fills_l2_way0
      kind: transition
      expression:
        kind: transition
        rule: mem_response
        operand: (implies (prev l2_lru) (and (eq (read l2_v0) True) (eq (read l2_d0)
          rdata)))
    - name: mem_response_fills_l2_way1
      kind: transition
      expression:
        kind: transition
        rule: mem_response
        operand: (implies (not (prev l2_lru)) (and (eq (read l2_v1) True) (eq (read
          l2_d1) rdata)))
    - name: mem_response_clears_arvalid
      kind: transition
      expression:
        kind: transition
        rule: mem_response
        operand: (eq (read arvalid) False)
    - name: store_allocates_rob
      kind: transition
      expression:
        kind: transition
        rule: store_issue0
        operand: (and (eq (read rob0_valid) True) (eq (read rob0_store) True))
    - name: store_data_in_rob
      kind: transition
      expression:
        kind: transition
        rule: store_issue0
        operand: (and (eq (read rob0_instr) store_addr) (eq (read rob0_data) store_data))
    - name: store_commit_issues_write
      kind: transition
      expression:
        kind: transition
        rule: commit0
        operand: (implies (prev rob0_store) (and (eq (read awvalid) True) (eq (read
          wvalid) True)))
    - name: store_commit_sets_awaddr
      kind: transition
      expression:
        kind: transition
        rule: commit0
        operand: (implies (prev rob0_store) (eq (read awaddr) (prev rob0_instr)))
    - name: load_allocates_rob
      kind: transition
      expression:
        kind: transition
        rule: load_issue0
        operand: (and (eq (read rob0_valid) True) (eq (read rob0_load) True))
    - name: load_addr_in_rob
      kind: transition
      expression:
        kind: transition
        rule: load_issue0
        operand: (eq (read rob0_instr) load_addr)
    - name: load_exec_issues_read
      kind: transition
      expression:
        kind: transition
        rule: load_exec0
        operand: (and (eq (read load_arvalid) True) (eq (read load_araddr) (prev rob0_instr)))
    - name: load_response_completes_load
      kind: transition
      expression:
        kind: transition
        rule: load_response
        operand: (implies (prev load_rob0) (eq (read rob0_done) True))
    - name: load_commit_writes_back
      kind: transition
      expression:
        kind: transition
        rule: commit0
        operand: (implies (prev rob0_load) (eq (read load_result) (prev rob0_data)))
    - name: store_load_forward
      kind: transition
      expression:
        kind: transition
        rule: load_forward0
        operand: (and (eq (read rob0_data) (prev rob1_data)) (eq (read rob0_done)
          True))
    - name: forwarded_load_no_read
      kind: transition
      expression:
        kind: transition
        rule: load_forward0
        operand: (eq (read load_arvalid) (prev load_arvalid))
    - name: write_response_completes
      kind: transition
      expression:
        kind: transition
        rule: write_response
        operand: (eq (read awvalid) False)
    - name: fill_l1_fills_way0
      kind: transition
      expression:
        kind: transition
        rule: fill_l1
        operand: (implies (prev ic_lru) (eq (read ic_v0) True))
    - name: fill_l1_fills_way1
      kind: transition
      expression:
        kind: transition
        rule: fill_l1
        operand: (implies (not (prev ic_lru)) (eq (read ic_v1) True))
    - name: issue_hit_delivers_rob0
      kind: transition
      expression:
        kind: transition
        rule: issue0
        operand: (eq (read rob0_instr) (fetch_instr (prev ic_v0) (prev ic_t0) (prev
          ic_d0) (prev ic_v1) (prev ic_t1) (prev ic_d1) (prev tlb_ppn)))
    - name: issue_way0_hit_updates_lru
      kind: transition
      expression:
        kind: transition
        rule: issue0
        operand: (implies (way_hit (prev ic_v0) (prev ic_t0) (prev tlb_ppn)) (eq (read
          ic_lru) False))
    - name: l1_hit_leaves_l2_lru
      kind: transition
      expression:
        kind: transition
        rule: issue0
        operand: (eq (read l2_lru) (prev l2_lru))
    - name: commit_in_order
      kind: transition
      expression:
        kind: transition
        rule: commit1
        operand: (eq (prev head) True)
  proof_obligations:
    - property: tlb_hit_way0_updates_lru
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: tlb_miss_fills_lru_way0
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: load_dc_hit
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: load_dc_miss_fills
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: store_writes_dc
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: fetch_sets_arvalid
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: fetch_sets_araddr
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: fill_l1_tags_with_ppn
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: mem_response_fills_l2_way0
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: mem_response_fills_l2_way1
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: mem_response_clears_arvalid
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: store_allocates_rob
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: store_data_in_rob
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: store_commit_issues_write
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: store_commit_sets_awaddr
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: load_allocates_rob
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: load_addr_in_rob
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: load_exec_issues_read
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: load_response_completes_load
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: load_commit_writes_back
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: store_load_forward
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: forwarded_load_no_read
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: write_response_completes
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: fill_l1_fills_way0
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: fill_l1_fills_way1
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: issue_hit_delivers_rob0
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: issue_way0_hit_updates_lru
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: l1_hit_leaves_l2_lru
      status: unproved
