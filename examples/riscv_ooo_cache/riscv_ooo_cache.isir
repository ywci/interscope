      status: unproved
      engine: theorem_proving
      backend: koika
    - property: tlb_miss_fills_lru_way0
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: fetch_sets_arvalid
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: fetch_sets_araddr
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: fill_l1_tags_with_ppn
      status: unproved
      engine: theorem_proving
