isir_version: "0.1"
module:
  name: axi_mem
  clocks:
    - name: clk
      edge: posedge
  resets:
    - name: rst
      polarity: active_high
      async: false
      affects: all
  inputs:
    - name: araddr
      direction: input
      type: "bits<4>"
    - name: arvalid
      direction: input
      type: "bool"
    - name: awaddr
      direction: input
      type: "bits<4>"
    - name: awvalid
      direction: input
      type: "bool"
    - name: wdata
      direction: input
      type: "bits<8>"
    - name: wvalid
      direction: input
      type: "bool"
  state:
    - name: mem
      kind: memory
      type:
        type: memory
        elem: "bits<8>"
        depth: 16
    - name: rdata
      kind: register
      type: "bits<8>"
      initial: 0
    - name: rvalid
      kind: register
      type: "bool"
      initial: false
    - name: bvalid
      kind: register
      type: "bool"
      initial: false
  rules:
    - name: do_read
      condition: arvalid
      action:
        - (write rdata (mem_read mem araddr))
        - (write rvalid true)
    - name: do_write
      condition: (and awvalid wvalid)
      action:
        - (mem_write mem awaddr wdata)
        - (write bvalid true)
  properties:
    - name: rvalid_bool
      kind: safety
      expression:
        kind: always
        operand: (or (eq (read rvalid) True) (eq (read rvalid) False))
    - name: bvalid_bool
      kind: safety
      expression:
        kind: always
        operand: (or (eq (read bvalid) True) (eq (read bvalid) False))
    - name: read_returns_data
      kind: transition
      expression:
        kind: transition
        rule: do_read
        operand: (eq (read rvalid) True)
    - name: write_acknowledges
      kind: transition
      expression:
        kind: transition
        rule: do_write
        operand: (eq (read bvalid) True)
    - name: read_returns_data
      kind: transition
      expression:
        kind: transition
        rule: do_read
        operand: (eq (read rdata) (mem_read mem araddr))
  proof_obligations:
    - property: read_returns_data
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: write_acknowledges
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: rvalid_bool
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: bvalid_bool
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: read_returns_data
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
