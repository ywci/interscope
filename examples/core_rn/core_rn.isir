isir_version: "0.1"
module:
  name: core_rn
  clocks:
    - name: clk
      edge: posedge
  resets:
    - name: rst
      polarity: active_high
      async: false
      affects: all
  inputs:
    # Request from the core's pipeline (what the L1 wants to do).
    - name: core_req_valid
      direction: input
      type: "bool"
    - name: core_req_write
      direction: input
      type: "bool"
    - name: core_req_addr
      direction: input
      type: "bits<4>"
    - name: core_req_data
      direction: input
      type: "bits<8>"
    # CHI SNP (HN -> RN): snoop from the home node.
    - name: snp_valid
      direction: input
      type: "bool"
    - name: snp_op
      direction: input
      type: "bool"      # true = invalidate (write snoop); false = downgrade (read snoop)
    - name: snp_addr
      direction: input
      type: "bits<4>"
    # CHI GRANT/RSP (HN -> RN): grant from the home node.
    - name: grant_valid
      direction: input
      type: "bool"
    - name: grant_write
      direction: input
      type: "bool"      # true = write grant (-> M); false = read grant (-> S)
    - name: grant_addr
      direction: input
      type: "bits<4>"
    - name: grant_data
      direction: input
      type: "bits<8>"
  components:
    # The core's L1 data cache (the actual line storage).  The RN control drives
    # it by asserting its request inputs.
    - name: l1
      module: "examples/l1_cache_comp/l1_cache_comp.isir"
      lift_properties: false
      port_map: {req_core: 0, req_write: l1_req_write, req_addr: l1_req_addr,
                 req_vpn: 0, is_physical: const_false, req_data: l1_req_data}
  state:
    # This RN's L1 line (MESI): the coherence/directory entry.
    - name: mstate
      kind: register
      type: "bits<2>"
      initial: 0
    - name: maddr
      kind: register
      type: "bits<4>"
      initial: 0
    - name: mdata
      kind: register
      type: "bits<8>"
      initial: 0
    # REQ channel output (RN -> HN).
    - name: req_out_valid
      kind: register
      type: "bool"
      initial: false
    - name: req_out_write
      kind: register
      type: "bool"
      initial: false
    - name: req_out_addr
      kind: register
      type: "bits<4>"
      initial: 0
    - name: req_out_data
      kind: register
      type: "bits<8>"
      initial: 0
    # RSP channel output (RN -> HN): snoop response.
    - name: snp_rsp_valid
      kind: register
      type: "bool"
      initial: false
    # Constant false (used as a tied-low port for the L1).
    - name: const_false
      kind: register
      type: "bool"
      initial: false
    # L1 request inputs (driven by the RN control).
    - name: l1_req_write
      kind: register
      type: "bool"
      initial: false
    - name: l1_req_addr
      kind: register
      type: "bits<4>"
      initial: 0
    - name: l1_req_data
      kind: register
      type: "bits<8>"
      initial: 0
  functions:
    - name: has_line
      params: [{name: s, type: "bits<2>"}, {name: a, type: "bits<4>"}, {name: ra, type: "bits<4>"}]
      return: "bool"
      body: (and (neq s 0) (eq a ra))
    - name: is_modified
      params: [{name: s, type: "bits<2>"}]
      return: "bool"
      body: (eq s 3)
  rules:
    # Issue a request onto the REQ channel and forward it to the L1.
    - name: issue_req
      condition: core_req_valid
      action:
        - (write req_out_valid true)
        - (write req_out_write core_req_write)
        - (write req_out_addr core_req_addr)
        - (write req_out_data core_req_data)
        - (write l1_req_write core_req_write)
        - (write l1_req_addr core_req_addr)
        - (write l1_req_data core_req_data)
    # Complete a request when the grant arrives.
    - name: complete_req
      condition: grant_valid
      action:
        - (write req_out_valid false)
    # Respond to a snoop: invalidate or downgrade the line (SNP -> RSP).
    - name: respond_snp
      condition: snp_valid
      action:
        - (write snp_rsp_valid true)
        - (write mstate (ite snp_op 0 (ite (eq (read mstate) 3) 1 (read mstate))))
    - name: clear_snp_rsp
      condition: (not snp_valid)
      action:
        - (write snp_rsp_valid false)
    # Receive a grant: adopt the granted state and data, and fill the L1.
    - name: receive_grant
      condition: grant_valid
      action:
        - (write mstate (ite grant_write 3 1))
        - (write maddr grant_addr)
        - (write mdata grant_data)
        - (write l1_req_write true)
        - (write l1_req_addr grant_addr)
        - (write l1_req_data grant_data)
  properties:
    - name: states_valid
      kind: safety
      expression:
        kind: always
        operand: (and (ge (read mstate) 0) (le (read mstate) 3))
  proof_obligations:
    - property: states_valid
      status: unproved
      engine: theorem_proving
      backend: koika
