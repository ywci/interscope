isir_version: "0.1"
module:
  name: core_rn
  clocks:
    - name: clk
      edge: posedge
  resets:
    - name: rst
      polarity: active_high
      async: false
      affects: all
  inputs:
    - name: core_req_valid
      direction: input
      type: "bool"
    - name: core_req_write
      direction: input
      type: "bool"
    - name: core_req_addr
      direction: input
      type: "bits<4>"
    - name: core_req_data
      direction: input
      type: "bits<8>"
    - name: snp_valid
      direction: input
      type: "bool"
    - name: snp_op
      direction: input
      type: "bool"
    - name: snp_addr
      direction: input
      type: "bits<4>"
    - name: grant_valid
      direction: input
      type: "bool"
    - name: grant_write
      direction: input
      type: "bool"
    - name: grant_addr
      direction: input
      type: "bits<4>"
    - name: grant_data
      direction: input
      type: "bits<8>"
  components:
    - name: l1
      module: "examples/l1_cache_comp/l1_cache_comp.isir"
      lift_properties: false
      port_map:
        req_core: 0
        req_write: l1_req_write
        req_addr: l1_req_addr
        req_vpn: 0
        is_physical: false
        req_data: l1_req_data
  state:
    - name: mstate
      kind: register
      type: "bits<2>"
      initial: 0
    - name: maddr
      kind: register
      type: "bits<4>"
      initial: 0
    - name: mdata
      kind: register
      type: "bits<8>"
      initial: 0
    - name: req_out_valid
      kind: register
      type: "bool"
      initial: false
    - name: req_out_write
      kind: register
      type: "bool"
      initial: false
    - name: req_out_addr
      kind: register
      type: "bits<4>"
      initial: 0
    - name: req_out_data
      kind: register
      type: "bits<8>"
      initial: 0
    - name: snp_rsp_valid
      kind: register
      type: "bool"
      initial: false
    - name: l1_req_write
      kind: register
      type: "bool"
      initial: false
    - name: l1_req_addr
      kind: register
      type: "bits<4>"
      initial: 0
    - name: l1_req_data
      kind: register
      type: "bits<8>"
      initial: 0
  functions:
    - name: has_line
      params:
        - name: s
          type: "bits<2>"
        - name: a
          type: "bits<4>"
        - name: ra
          type: "bits<4>"
      return: "bool"
      body: (and (neq s 0) (eq a ra))
    - name: is_modified
      params:
        - name: s
          type: "bits<2>"
      return: "bool"
      body: (eq s 3)
  rules:
    - name: issue_req
      condition: core_req_valid
      action:
        - (write req_out_valid true)
        - (write req_out_write core_req_write)
        - (write req_out_addr core_req_addr)
        - (write req_out_data core_req_data)
        - (write l1_req_write core_req_write)
        - (write l1_req_addr core_req_addr)
        - (write l1_req_data core_req_data)
    - name: complete_req
      condition: grant_valid
      action:
        - (write req_out_valid false)
    - name: respond_snp
      condition: snp_valid
      action:
        - (write snp_rsp_valid true)
        - (write mstate (ite snp_op 0 (ite (eq (read mstate) 3) 1 (read mstate))))
    - name: clear_snp_rsp
      condition: (not snp_valid)
      action:
        - (write snp_rsp_valid false)
    - name: receive_grant
      condition: grant_valid
      action:
        - (write mstate (ite grant_write 3 1))
        - (write maddr grant_addr)
        - (write mdata grant_data)
        - (write l1_req_write true)
        - (write l1_req_addr grant_addr)
        - (write l1_req_data grant_data)
  properties:
    - name: has_line_holds_line
      kind: safety
      expression:
        kind: always
        operand: (implies (has_line (read mstate) (read maddr) (read maddr)) (neq
          (read mstate) 0))
    - name: is_modified_implies_valid
      kind: safety
      expression:
        kind: always
        operand: (implies (is_modified (read mstate)) (neq (read mstate) 0))
    - name: l1_is_modified_implies_valid
      kind: safety
      expression:
        kind: always
        operand: (implies (l1_is_modified (read l1_s0)) (neq (read l1_s0) 0))
    - name: states_valid
      kind: safety
      expression:
        kind: always
        operand: (and (ge (read mstate) 0) (le (read mstate) 3))
    - name: request_forwarded_out
      kind: transition
      expression:
        kind: transition
        rule: issue_req
        operand: (and (eq (read req_out_valid) True) (and (eq (read req_out_write)
          core_req_write) (and (eq (read req_out_addr) core_req_addr) (and (eq (read
          req_out_data) core_req_data) (and (eq (read l1_req_write) core_req_write)
          (and (eq (read l1_req_addr) core_req_addr) (eq (read l1_req_data) core_req_data)))))))
    - name: request_deasserts_on_grant
      kind: transition
      expression:
        kind: transition
        rule: complete_req
        operand: (eq (read req_out_valid) False)
    - name: snoop_response_updates_state
      kind: transition
      expression:
        kind: transition
        rule: respond_snp
        operand: (and (eq (read snp_rsp_valid) True) (eq (read mstate) (ite snp_op
          0 (ite (eq (prev mstate) 3) 1 (prev mstate)))))
    - name: snoop_response_deasserts
      kind: transition
      expression:
        kind: transition
        rule: clear_snp_rsp
        operand: (eq (read snp_rsp_valid) False)
    - name: grant_updates_cache_line
      kind: transition
      expression:
        kind: transition
        rule: receive_grant
        operand: (and (eq (read mstate) (ite grant_write 3 1)) (and (eq (read maddr)
          grant_addr) (and (eq (read mdata) grant_data) (and (eq (read l1_req_write)
          True) (and (eq (read l1_req_addr) grant_addr) (eq (read l1_req_data) grant_data))))))
  proof_obligations:
    - property: request_forwarded_out
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: request_deasserts_on_grant
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: snoop_response_updates_state
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: snoop_response_deasserts
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: grant_updates_cache_line
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: has_line_holds_line
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: is_modified_implies_valid
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: l1_is_modified_implies_valid
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: states_valid
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
