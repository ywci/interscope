isir_version: "0.1"
module:
  name: mmu_comp
  clocks:
    - name: clk
      edge: posedge
  resets:
    - name: rst
      polarity: active_high
      async: false
      affects: all
  inputs:
    - name: i_vpn
      direction: input
      type: "bits<4>"
    - name: d_vpn
      direction: input
      type: "bits<4>"
    - name: va
      direction: input
      type: "bits<8>"
    - name: ptw_mem_data
      direction: input
      type: "bits<8>"
  components:
    - name: itlb
      module: "examples/tlb/tlb.isir"
      lift_properties: false
      port_map:
        vpn: i_vpn
        ppn_in: ppn_fill
        tlb_ppn: i_ppn
        miss: i_miss
    - name: dtlb
      module: "examples/tlb/tlb.isir"
      lift_properties: false
      port_map:
        vpn: d_vpn
        ppn_in: ppn_fill
        tlb_ppn: d_ppn
        miss: d_miss
    - name: ptw
      module: "examples/ptw/ptw.isir"
      lift_properties: false
      port_map:
        va: va
        start: miss_signal
        mem_data: ptw_mem_data
        mem_addr: ptw_mem_addr
        result_ppn: ptw_ppn
  state:
    - name: ptw_mem_addr
      kind: register
      type: "bits<4>"
      initial: 0
    - name: ptw_active
      kind: register
      type: "bool"
      initial: false
    - name: ppn_fill
      kind: register
      type: "bits<4>"
      initial: 0
    - name: i_ppn
      kind: register
      type: "bits<4>"
      initial: 0
    - name: d_ppn
      kind: register
      type: "bits<4>"
      initial: 0
    - name: i_miss
      kind: register
      type: "bool"
      initial: false
    - name: d_miss
      kind: register
      type: "bool"
      initial: false
    - name: miss_signal
      kind: register
      type: "bool"
      initial: false
    - name: ptw_ppn
      kind: register
      type: "bits<4>"
      initial: 0
  rules:
    - name: combine_miss
      condition: "true"
      action:
        - (write miss_signal (or (read i_miss) (read d_miss)))
    - name: slice_ppn
      condition: "true"
      action:
        - (write ppn_fill (read ptw_ppn))
    - name: ptw_is_active
      condition: "true"
      action:
        - (write ptw_active (neq (read ptw_walk_state) 0))
  properties:
    - name: itlb_hit_sets_i_ppn
      kind: transition
      expression:
        kind: transition
        rule: itlb_hit0
        operand: (eq (read i_ppn) (read itlb_way0_ppn))
    - name: dtlb_hit_sets_d_ppn
      kind: transition
      expression:
        kind: transition
        rule: dtlb_hit0
        operand: (eq (read d_ppn) (read dtlb_way0_ppn))
    - name: walk_on_miss
      kind: transition
      expression:
        kind: transition
        rule: combine_miss
        operand: (eq (read miss_signal) (or (read i_miss) (read d_miss)))
    - name: fill_from_leaf
      kind: transition
      expression:
        kind: transition
        rule: slice_ppn
        operand: (eq (read ppn_fill) (read ptw_ppn))
  proof_obligations:
    - property: itlb_hit_sets_i_ppn
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: dtlb_hit_sets_d_ppn
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: walk_on_miss
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: fill_from_leaf
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
