isir_version: "0.1"
module:
  name: blackbox
  version: "1.0"
  clocks:
    - name: clk
      edge: posedge
  resets:
    - name: rst_n
      polarity: active_low
      async: false
      affects: all

  inputs:
    - name: x
      direction: input
      type: "bits<8>"
      protocol: fixed_cycle
    - name: enable
      direction: input
      type: "bool"
      protocol: fixed_cycle

  outputs:
    - name: y
      direction: output
      type: "bits<8>"
      protocol: fixed_cycle

  state:
    - name: y
      kind: register
      type: "bits<8>"
      initial: 0

  functions:
    - name: sigmoid
      params:
        - name: v
          type: "bits<8>"
      return: "bits<8>"

  axioms:
    - name: sigmoid_zero_is_zero
      statement: (eq (sigmoid 0) 0)
    - name: sigmoid_stays_in_range
      statement: (lt (sigmoid v) 256)

  rules:
    - name: activate
      condition: enable
      action:
        - (write y (sigmoid (read x)))

  properties:
    - name: y_bounded
      kind: safety
      expression:
        kind: always
        operand: (lt (read y) 256)
    - name: activate_passes_sigmoid
      kind: transition
      expression:
        kind: transition
        rule: activate
        operand: (eq (read y) (sigmoid x))

  proof_obligations:
    - property: y_bounded
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: activate_passes_sigmoid
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: y_bounded
      engine: model_checking
