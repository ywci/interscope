isir_version: "0.1"
module:
  name: stack
  clocks:
    - name: clk
      edge: posedge
  resets:
    - name: rst
      polarity: active_high
      async: false
      affects: all
  inputs:
    - name: push
      direction: input
      type: "bool"
    - name: pop
      direction: input
      type: "bool"
    - name: data_in
      direction: input
      type: "bits<32>"
  outputs:
    - name: data_out
      direction: output
      type: "bits<32>"
    - name: full
      direction: output
      type: "bool"
    - name: empty
      direction: output
      type: "bool"
  state:
    - name: mem
      kind: memory
      type:
        type: memory
        elem: "bits<32>"
        depth: 8
    - name: sp
      kind: register
      type: "bits<4>"
      initial: 0
    - name: data_out
      kind: register
      type: "bits<32>"
      initial: 0
    - name: full
      kind: register
      type: "bool"
      initial: false
    - name: empty
      kind: register
      type: "bool"
      initial: true
  rules:
    - name: push
      condition: (and push (lt (read sp) 8))
      action:
        - (mem_write mem (slice (read sp) 2 0) data_in)
        - (write sp (add (read sp) 1))
    - name: pop
      condition: (and pop (gt (read sp) 0))
      action:
        - (write data_out (mem_read mem (slice (sub (read sp) 1) 2 0)))
        - (write sp (sub (read sp) 1))
    - name: update_flags
      condition: "true"
      action:
        - (write full (eq (read sp) 8))
        - (write empty (eq (read sp) 0))
  properties:
    - name: full_iff_sp_eq_depth
      kind: safety
      expression:
        kind: always
        operand: (eq full (eq (read sp) 8))
    - name: push_increments
      kind: transition
      expression:
        kind: transition
        rule: push
        operand: (eq (read sp) (add (prev sp) 1))
    - name: pop_decrements
      kind: transition
      expression:
        kind: transition
        rule: pop
        operand: (eq (read sp) (sub (prev sp) 1))
    - name: flags_track_sp
      kind: transition
      expression:
        kind: transition
        rule: update_flags
        operand: (and (eq full (eq (prev sp) 8)) (eq empty (eq (prev sp) 0)))
    - name: pop_returns_data
      kind: transition
      expression:
        kind: transition
        rule: pop
        operand: (eq (read data_out) (mem_read mem (slice (sub (prev sp) 1) 2 0)))
  proof_obligations:
    - property: push_increments
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: full_iff_sp_eq_depth
      engine: model_checking
    - property: pop_decrements
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: flags_track_sp
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: full_iff_sp_eq_depth
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: pop_returns_data
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
