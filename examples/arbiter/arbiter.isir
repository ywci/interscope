isir_version: "0.1"
module:
  name: arbiter
  clocks:
    - name: clk
      edge: posedge
  resets:
    - name: rst
      polarity: active_high
      async: false
      affects: all
  inputs:
    - name: req0_valid
      direction: input
      type: "bool"
    - name: req1_valid
      direction: input
      type: "bool"
  state:
    - name: grant
      kind: register
      type: "bool"
      initial: false   # false = grant req0, true = grant req1
    - name: grant_valid
      kind: register
      type: "bool"
      initial: false
  rules:
    - name: arbitrate
      condition: "true"
      action:
        - (write grant (and (not req0_valid) req1_valid))
        - (write grant_valid (or req0_valid req1_valid))
  properties:
    - name: grant0_when_req0
      kind: transition
      expression:
        kind: transition
        rule: arbitrate
        operand: (implies req0_valid (eq (read grant) false))
  proof_obligations:
    - property: grant0_when_req0
      status: unproved
      engine: theorem_proving
      backend: koika
