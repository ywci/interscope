isir_version: "0.1"
module:
  name: gelu_engine
  clocks:
    - name: clk
      edge: posedge
      period: "10ns"
  resets:
    - name: rst_n
      polarity: active_low
      async: false
      affects: all
  inputs:
    - name: x
      direction: input
      type: "bits<8>"
    - name: valid
      direction: input
      type: "bool"
  state:
    - name: out
      kind: register
      type: "bits<8>"
      initial: 0
  functions:
    - name: gelu
      params:
        - name: x
          type: "bits<8>"
      return: "bits<8>"
      body: (min (max 0 (sub x 32)) 255)
  rules:
    - name: compute
      condition: valid
      action:
        - (write out (gelu x))
  properties:
    - name: out_equals_gelu_x
      kind: safety
      expression:
        kind: always
        operand: (eq (read out) (gelu x))
    - name: out_applies_gelu
      kind: transition
      expression:
        kind: transition
        rule: compute
        operand: (eq (read out) (gelu x))
  proof_obligations:
    - property: out_applies_gelu
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: out_equals_gelu_x
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
