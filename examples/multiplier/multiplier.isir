isir_version: "0.1"
module:
  name: multiplier
  clocks:
    - name: clk
      edge: posedge
  resets:
    - name: rst
      polarity: active_high
      async: false
      affects: all
  inputs:
    - name: start
      direction: input
      type: "bool"
    - name: x
      direction: input
      type: "bits<16>"
    - name: y
      direction: input
      type: "bits<16>"
  outputs:
    - name: product
      direction: output
      type: "bits<32>"
    - name: done
      direction: output
      type: "bool"
  state:
    - name: multiplicand
      kind: register
      type: "bits<16>"
      initial: 0
    - name: multiplier
      kind: register
      type: "bits<16>"
      initial: 0
    - name: acc
      kind: register
      type: "bits<32>"
      initial: 0
    - name: count
      kind: register
      type: "bits<5>"
      initial: 0
    - name: done
      kind: register
      type: "bool"
      initial: false
    - name: product
      kind: register
      type: "bits<32>"
      initial: 0
  rules:
    - name: load
      condition: start
      action:
        - (write multiplicand (read x))
        - (write multiplier (read y))
        - (write acc 0)
        - (write count 0)
        - (write done false)
    - name: add_step
      condition: (and (not (read done)) (and (lt (read count) 16) (eq (mod (read multiplier) 2) 1)))
      action:
        - (write acc (add (read acc) (read multiplicand)))
        - (write multiplier (div (read multiplier) 2))
        - (write count (add (read count) 1))
    - name: shift_step
      condition: (and (not (read done)) (and (lt (read count) 16) (eq (mod (read multiplier) 2) 0)))
      action:
        - (write multiplier (div (read multiplier) 2))
        - (write count (add (read count) 1))
    - name: finish
      condition: (and (not (read done)) (ge (read count) 16))
      action:
        - (write done true)
        - (write product (read acc))
  properties:
    - name: count_in_range
      kind: safety
      expression:
        kind: always
        operand: (and (ge (read count) 0) (le (read count) 16))
    - name: acc_nonneg
      kind: safety
      expression:
        kind: always
        operand: (ge (read acc) 0)
  proof_obligations:
    - property: count_in_range
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: acc_nonneg
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: count_in_range
      engine: model_checking
