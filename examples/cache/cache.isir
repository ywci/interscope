isir_version: "0.1"
module:
  name: l2_cache
  clocks:
    - name: clk
      edge: posedge
  resets:
    - name: rst
      polarity: active_high
      async: false
      affects: all
  inputs:
    - name: addr
      direction: input
      type: "bits<8>"
    - name: wdata
      direction: input
      type: "bits<8>"
  outputs:
    - name: hit
      direction: output
      type: "bool"
    - name: rdata
      direction: output
      type: "bits<8>"
  state:
    # L1: 2-way set-associative (single set) with LRU.
    - name: l1_v0
      kind: register
      type: "bool"
      initial: false
    - name: l1_t0
      kind: register
      type: "bits<4>"
      initial: 0
    - name: l1_d0
      kind: register
      type: "bits<8>"
      initial: 0
    - name: l1_v1
      kind: register
      type: "bool"
      initial: false
    - name: l1_t1
      kind: register
      type: "bits<4>"
      initial: 0
    - name: l1_d1
      kind: register
      type: "bits<8>"
      initial: 0
    - name: l1_lru
      kind: register
      type: "bool"
      initial: false   # false = way 0 is LRU
    # L2: 2-way set-associative (single set) with LRU.
    - name: l2_v0
      kind: register
      type: "bool"
      initial: false
    - name: l2_t0
      kind: register
      type: "bits<4>"
      initial: 0
    - name: l2_d0
      kind: register
      type: "bits<8>"
      initial: 0
    - name: l2_v1
      kind: register
      type: "bool"
      initial: false
    - name: l2_t1
      kind: register
      type: "bits<4>"
      initial: 0
    - name: l2_d1
      kind: register
      type: "bits<8>"
      initial: 0
    - name: l2_lru
      kind: register
      type: "bool"
      initial: false   # false = way 0 is LRU
    # Control / outputs.
    - name: hit
      kind: register
      type: "bool"
      initial: false
    - name: rdata
      kind: register
      type: "bits<8>"
      initial: 0

  functions:
    - name: tag
      params: [{name: a, type: "bits<8>"}]
      return: "bits<4>"
      body: (slice a 7 4)
    - name: way_hit
      params: [{name: v, type: "bool"}, {name: t, type: "bits<4>"}, {name: a, type: "bits<8>"}]
      return: "bool"
      body: (and v (eq t (tag a)))
    - name: set_hit
      params: [{name: v0, type: "bool"}, {name: t0, type: "bits<4>"}, {name: v1, type: "bool"}, {name: t1, type: "bits<4>"}, {name: a, type: "bits<8>"}]
      return: "bool"
      body: (or (way_hit v0 t0 a) (way_hit v1 t1 a))

  rules:
    # One cache access: L1 lookup, LRU update, and fill of the LRU way on a
    # miss; on an L1 miss the L2 LRU is also updated.
    - name: access
      condition: "true"
      action:
        - (write hit (set_hit (read l1_v0) (read l1_t0) (read l1_v1) (read l1_t1) addr))
        - (write rdata
            (ite (way_hit (read l1_v0) (read l1_t0) addr) (read l1_d0)
                 (ite (way_hit (read l1_v1) (read l1_t1) addr) (read l1_d1) 0)))
        # L1 LRU: hit way0 -> way1 LRU (false); hit way1 -> way0 LRU (true);
        # miss -> toggle (the filled LRU way becomes MRU).
        - (write l1_lru
            (ite (way_hit (read l1_v0) (read l1_t0) addr) false
                 (ite (way_hit (read l1_v1) (read l1_t1) addr) true
                      (not (read l1_lru)))))
        # L2 LRU: unchanged on L1 hit; otherwise LRU-update like L1.
        - (write l2_lru
            (ite (set_hit (read l1_v0) (read l1_t0) (read l1_v1) (read l1_t1) addr)
                 (read l2_lru)
                 (ite (way_hit (read l2_v0) (read l2_t0) addr) false
                      (ite (way_hit (read l2_v1) (read l2_t1) addr) true
                           (not (read l2_lru))))))
        # Fill L1 LRU way on miss: valid + new tag (data is a toy 0).
        - (write l1_v0
            (ite (and (not (set_hit (read l1_v0) (read l1_t0) (read l1_v1) (read l1_t1) addr))
                      (not (read l1_lru)))
                 true (read l1_v0)))
        - (write l1_t0
            (ite (and (not (set_hit (read l1_v0) (read l1_t0) (read l1_v1) (read l1_t1) addr))
                      (not (read l1_lru)))
                 (tag addr) (read l1_t0)))
        - (write l1_v1
            (ite (and (not (set_hit (read l1_v0) (read l1_t0) (read l1_v1) (read l1_t1) addr))
                      (read l1_lru))
                 true (read l1_v1)))
        - (write l1_t1
            (ite (and (not (set_hit (read l1_v0) (read l1_t0) (read l1_v1) (read l1_t1) addr))
                      (read l1_lru))
                 (tag addr) (read l1_t1)))

  properties:
    - name: l1_lru_bool
      kind: safety
      expression:
        kind: always
        operand: (or (eq (read l1_lru) true) (eq (read l1_lru) false))
    - name: way0_hit_updates_lru
      kind: transition
      expression:
        kind: transition
        rule: access
        operand: (implies (way_hit (prev l1_v0) (prev l1_t0) addr)
                         (eq (read l1_lru) false))
    - name: way1_hit_updates_lru
      kind: transition
      expression:
        kind: transition
        rule: access
        operand: (implies (and (not (way_hit (prev l1_v0) (prev l1_t0) addr))
                              (way_hit (prev l1_v1) (prev l1_t1) addr))
                         (eq (read l1_lru) true))
    - name: hit_implies_valid
      kind: safety
      expression:
        kind: always
        operand: (implies (read hit) (or (read l1_v0) (read l1_v1)))
    - name: l1_hit_leaves_l2_lru
      kind: transition
      expression:
        kind: transition
        rule: access
        operand: (implies (set_hit (prev l1_v0) (prev l1_t0) (prev l1_v1) (prev l1_t1) addr)
                         (eq (read l2_lru) (prev l2_lru)))

  proof_obligations:
    - property: l1_lru_bool
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: way0_hit_updates_lru
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: way1_hit_updates_lru
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: hit_implies_valid
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: l1_hit_leaves_l2_lru
      status: unproved
      engine: theorem_proving
      backend: koika

    - property: l1_lru_bool
      engine: model_checking
    - property: hit_implies_valid
      engine: model_checking
