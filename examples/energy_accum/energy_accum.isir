isir_version: "0.1"
module:
  name: energy_accum
  clocks:
    - name: clk
      edge: posedge
  resets:
    - name: rst
      polarity: active_high
      async: false
      affects: all
  inputs:
    - name: valid
      direction: input
      type: "bool"
    - name: sample
      direction: input
      type: "bits<8>"
  outputs:
    - name: energy_out
      direction: output
      type: "bits<32>"
  state:
    - name: energy
      kind: register
      type: "bits<32>"
      initial: 0
  functions:
    - name: square
      params:
        - name: x
          type: "bits<8>"
      return: "bits<16>"
      body: (mul_full x x)
  rules:
    - name: measure
      condition: valid
      action:
        - (write energy (square sample))
  properties:
    - name: energy_squares_sample
      kind: transition
      expression:
        kind: transition
        rule: measure
        operand: (eq (read energy) (square (prev sample)))
    - name: energy_equals_sample_squared
      kind: safety
      expression:
        kind: always
        operand: (eq (read energy) (square sample))
        reference: t
  proof_obligations:
    - property: energy_squares_sample
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: energy_equals_sample_squared
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
