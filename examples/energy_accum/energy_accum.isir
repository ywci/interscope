isir_version: "0.1"
module:
  name: energy_accum
  clocks:
    - name: clk
      edge: posedge
  resets:
    - name: rst
      polarity: active_high
      async: false
      affects: all
  inputs:
    - name: valid
      direction: input
      type: "bool"
    - name: sample
      direction: input
      type: "bits<8>"
  outputs:
    - name: energy_out
      direction: output
      type: "bits<32>"
  state:
    - name: energy
      kind: register
      type: "bits<32>"
      initial: 0
  functions:
    - name: square
      params: [{name: x, type: "bits<8>"}]
      return: "bits<16>"
      body: (mul_full x x)
  rules:
    - name: measure
      condition: valid
      action:
        - (write energy (square sample))
  properties:
    # transition step-identity: energy' = sample^2 (the square is the
    # NON-LINEAR part `lia` cannot discharge).
    - name: energy_step
      kind: transition
      expression:
        kind: transition
        operand: (eq (read energy) (square (prev sample)))
      rule: measure
    # always invariant: the measured energy fits in 16 bits (sample^2 <= 65025).
    - name: energy_bounded
      kind: safety
      expression:
        kind: always
        operand: (le (read energy) 65025)
        reference: t
  proof_obligations:
    - property: energy_step
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: energy_bounded
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
