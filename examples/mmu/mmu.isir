isir_version: "0.1"
module:
  name: mmu
  clocks:
    - name: clk
      edge: posedge
  resets:
    - name: rst
      polarity: active_high
      async: false
      affects: all
  inputs:
    - name: va
      direction: input
      type: "bits<8>"   # virtual address: VPN[7:2] | offset[1:0]
  state:
    - name: ppn
      kind: register
      type: "bits<6>"
      initial: 0       # physical page number (translated VPN)
    - name: pa
      kind: register
      type: "bits<8>"
      initial: 0       # physical address: PPN[7:2] | offset[1:0]
  rules:
    # Identity translation for now: PPN = VPN, offset passes through.
    - name: translate
      condition: "true"
      action:
        - (write ppn (slice va 2 8))
        - (write pa va)
  properties:
    - name: pa_matches_va
      kind: transition
      expression:
        kind: transition
        rule: translate
        operand: (eq (read pa) va)
  proof_obligations:
    - property: pa_matches_va
      status: unproved
      engine: theorem_proving
      backend: koika
