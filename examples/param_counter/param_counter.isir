isir_version: "0.1"
module:
  name: param_counter
  parameters:
    - name: width
      type: int
      default: 4
    - name: modulus
      type: int
      default: 16
  clocks:
    - name: clk
      edge: posedge
  resets:
    - name: rst
      polarity: active_high
      async: false
      affects: all
  inputs:
    - name: enable
      direction: input
      type: "bool"
  state:
    - name: count
      kind: register
      type: "bits<$width>"
      initial: 0
  rules:
    - name: tick
      condition: enable
      action:
        - (write count (mod (add (read count) 1) $modulus))
  properties:
    - name: count_in_range
      kind: safety
      expression:
        kind: always
        operand: (and (ge (read count) 0) (lt (read count) $modulus))
    - name: tick_wraps
      kind: transition
      expression:
        kind: transition
        rule: tick
        operand: (eq (read count) (mod (add (prev count) 1) $modulus))
  proof_obligations:
    - property: count_in_range
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: tick_wraps
      status: unproved
      engine: theorem_proving
      backend: koika
