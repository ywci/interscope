isir_version: "0.1"
module:
  name: gcd
  clocks:
    - name: clk
      edge: posedge
  resets:
    - name: rst
      polarity: active_high
      async: false
      affects: all
  inputs:
    - name: start
      direction: input
      type: "bool"
    - name: x
      direction: input
      type: "bits<16>"
    - name: y
      direction: input
      type: "bits<16>"
  outputs:
    - name: result
      direction: output
      type: "bits<16>"
    - name: done
      direction: output
      type: "bool"
  state:
    - name: a
      kind: register
      type: "bits<16>"
      initial: 0
    - name: b
      kind: register
      type: "bits<16>"
      initial: 0
    - name: done
      kind: register
      type: "bool"
      initial: false
    - name: result
      kind: register
      type: "bits<16>"
      initial: 0

  # Subtractive Euclidean algorithm as a recursive semantic model.  Its
  # one-step facts (e.g. gcd_sub (a-b) b = gcd_sub a b when a > b) are
  # definitional unfoldings of the well-founded recursion.
  functions:
    - name: gcd_sub
      params: [{name: a, type: "bits<16>"}, {name: b, type: "bits<16>"}]
      return: "bits<16>"
      recursive: true
      measure: (add a b)
      body: (ite (eq a 0) b
            (ite (eq b 0) a
            (ite (gt a b) (gcd_sub (sub a b) b)
                 (gcd_sub a (sub b a)))))

  rules:
    - name: load
      condition: start
      action:
        - (write a (read x))
        - (write b (read y))
        - (write done false)
    - name: step_a
      condition: (and (not (read done)) (gt (read a) (read b)))
      action:
        - (write a (sub (read a) (read b)))
    - name: step_b
      condition: (and (not (read done)) (gt (read b) (read a)))
      action:
        - (write b (sub (read b) (read a)))
    - name: finish
      condition: (and (not (read done)) (eq (read a) (read b)))
      action:
        - (write done true)
        - (write result (read a))
  properties:
    - name: operands_nonneg
      kind: safety
      expression:
        kind: always
        operand: (and (ge (read a) 0) (ge (read b) 0))
    - name: done_implies_equal
      kind: safety
      expression:
        kind: always
        operand: (implies (read done) (eq (read a) (read b)))
    - name: done_implies_result_eq_a
      kind: safety
      expression:
        kind: always
        operand: (implies (read done) (eq (read result) (read a)))
    - name: gcd_commutes
      kind: combinational
      expression:
        kind: combinational
        operand: (gcd_sub x y)
        reference: (gcd_sub y x)
    - name: gcd_diag
      kind: combinational
      expression:
        kind: combinational
        operand: (gcd_sub x x)
        reference: x
    - name: gcd_sub_computes
      kind: combinational
      expression:
        kind: combinational
        operand: (gcd_sub 10 6)
        reference: 2
    - name: gcd_sub_step
      kind: combinational
      expression:
        kind: combinational
        operand: (gcd_sub 10 6)
        reference: (gcd_sub 4 6)
  proof_obligations:
    - property: done_implies_equal
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: done_implies_result_eq_a
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: operands_nonneg
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: gcd_commutes
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: gcd_commutes
      status: unproved
      engine: theorem_proving
      backend: acl2
    - property: gcd_diag
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: gcd_diag
      status: unproved
      engine: theorem_proving
      backend: acl2
    - property: gcd_sub_computes
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: gcd_sub_computes
      status: unproved
      engine: theorem_proving
      backend: acl2
    - property: gcd_sub_step
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: gcd_sub_step
      status: unproved
      engine: theorem_proving
      backend: acl2
    - property: done_implies_equal
      engine: model_checking
