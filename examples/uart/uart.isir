isir_version: "0.1"
module:
  name: uart
  clocks:
    - name: clk
      edge: posedge
  resets:
    - name: rst
      polarity: active_high
      async: false
      affects: all
  inputs:
    - name: rx
      direction: input
      type: "bool"
  outputs:
    - name: data_out
      direction: output
      type: "bits<8>"
    - name: data_valid
      direction: output
      type: "bool"
  state:
    - name: fsm_state
      kind: register
      type: "bits<2>"
      initial: 0
    - name: sample_cnt
      kind: register
      type: "bits<3>"
      initial: 0
    - name: bit_cnt
      kind: register
      type: "bits<3>"
      initial: 0
    - name: rx_shift
      kind: register
      type: "bits<8>"
      initial: 0
    - name: rx_prev
      kind: register
      type: "bool"
      initial: true
    - name: data_out_reg
      kind: register
      type: "bits<8>"
      initial: 0
    - name: data_valid_reg
      kind: register
      type: "bool"
      initial: false
  rules:
    - name: edge_detect
      condition: "true"
      action:
        - (write rx_prev (read rx))
    - name: detect_start
      condition: (and (eq (read fsm_state) 0) (and (not (read rx)) (read rx_prev)))
      action:
        - (write fsm_state 1)
        - (write sample_cnt 0)
        - (write bit_cnt 0)
        - (write data_valid_reg false)
    - name: verify_start
      condition: (and (eq (read fsm_state) 1) (eq (read sample_cnt) 2))
      action:
        - (write fsm_state (ite (not (read rx)) 2 0))
        - (write sample_cnt 0)
    - name: sample_data
      condition: (and (eq (read fsm_state) 2) (eq (read sample_cnt) 2))
      action:
        - (write rx_shift (add (mul (slice (read rx_shift) 6 0) 2) (ite (read rx)
          1 0)))
        - (write bit_cnt (add (read bit_cnt) 1))
        - (write fsm_state (ite (eq (read bit_cnt) 7) 3 2))
        - (write sample_cnt 0)
    - name: sample_stop
      condition: (and (eq (read fsm_state) 3) (eq (read sample_cnt) 2))
      action:
        - (write data_out_reg (read rx_shift))
        - (write data_valid_reg (read rx))
        - (write fsm_state 0)
        - (write sample_cnt 0)
    - name: inc_sample
      condition: (not (or (and (eq (read fsm_state) 1) (eq (read sample_cnt) 2)) (or
        (and (eq (read fsm_state) 2) (eq (read sample_cnt) 2)) (and (eq (read fsm_state)
        3) (eq (read sample_cnt) 2)))))
      action:
        - (write sample_cnt (add (read sample_cnt) 1))
  properties:
    - name: valid_pulse
      kind: safety
      expression:
        kind: always
        operand: (implies (read data_valid_reg) (eq (read fsm_state) 0))
    - name: data_out_equals_rx_shift
      kind: safety
      expression:
        kind: always
        operand: (eq (read data_out_reg) (read rx_shift))
    - name: rx_prev_bool
      kind: safety
      expression:
        kind: always
        operand: (or (eq (read rx_prev) True) (eq (read rx_prev) False))
    - name: data_valid_reg_bool
      kind: safety
      expression:
        kind: always
        operand: (or (eq (read data_valid_reg) True) (eq (read data_valid_reg) False))
    - name: rx_edge_sampled
      kind: transition
      expression:
        kind: transition
        rule: edge_detect
        operand: (eq (read rx_prev) (prev rx))
    - name: start_bit_detected
      kind: transition
      expression:
        kind: transition
        rule: detect_start
        operand: (and (eq (read fsm_state) 1) (and (eq (read sample_cnt) 0) (and (eq
          (read bit_cnt) 0) (eq (read data_valid_reg) False))))
    - name: start_bit_verified
      kind: transition
      expression:
        kind: transition
        rule: verify_start
        operand: (and (eq (read fsm_state) (ite (not (prev rx)) 2 0)) (eq (read sample_cnt)
          0))
    - name: data_bit_sampled
      kind: transition
      expression:
        kind: transition
        rule: sample_data
        operand: (and (eq (read rx_shift) (add (mul (slice (prev rx_shift) 6 0) 2)
          (ite (prev rx) 1 0))) (and (eq (read bit_cnt) (add (prev bit_cnt) 1)) (and
          (eq (read fsm_state) (ite (eq (prev bit_cnt) 7) 3 2)) (eq (read sample_cnt)
          0))))
    - name: stop_bit_sampled
      kind: transition
      expression:
        kind: transition
        rule: sample_stop
        operand: (and (eq (read data_out_reg) (prev rx_shift)) (and (eq (read data_valid_reg)
          (prev rx)) (and (eq (read fsm_state) 0) (eq (read sample_cnt) 0))))
    - name: sample_counter_increments
      kind: transition
      expression:
        kind: transition
        rule: inc_sample
        operand: (eq (read sample_cnt) (add (prev sample_cnt) 1))
  proof_obligations:
    - property: rx_edge_sampled
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: start_bit_detected
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: start_bit_verified
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: data_bit_sampled
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: stop_bit_sampled
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: sample_counter_increments
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: valid_pulse
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: valid_pulse
      engine: model_checking
    - property: data_out_equals_rx_shift
      engine: model_checking
    - property: rx_prev_bool
      engine: model_checking
    - property: data_valid_reg_bool
      engine: model_checking
    - property: data_out_equals_rx_shift
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: rx_prev_bool
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: data_valid_reg_bool
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
