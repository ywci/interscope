isir_version: "0.1"
module:
  name: systolic_array
  clocks:
    - name: clk
      edge: posedge
      period: "10ns"
  resets:
    - name: rst_n
      polarity: active_low
      async: false
      affects: all
  inputs:
    - name: a0
      direction: input
      type: "bits<8>"
    - name: a1
      direction: input
      type: "bits<8>"
    - name: load_valid
      direction: input
      type: "bool"
    - name: w_in00
      direction: input
      type: "bits<8>"
    - name: w_in01
      direction: input
      type: "bits<8>"
    - name: w_in10
      direction: input
      type: "bits<8>"
    - name: w_in11
      direction: input
      type: "bits<8>"
    - name: scale
      direction: input
      type: "bits<8>"
    - name: shift
      direction: input
      type: "bits<4>"
    - name: run
      direction: input
      type: "bool"
  state:
    - name: w00
      kind: register
      type: "bits<8>"
      initial: 0
    - name: w01
      kind: register
      type: "bits<8>"
      initial: 0
    - name: w10
      kind: register
      type: "bits<8>"
      initial: 0
    - name: w11
      kind: register
      type: "bits<8>"
      initial: 0
    - name: acc0
      kind: register
      type: "bits<32>"
      initial: 0
    - name: acc1
      kind: register
      type: "bits<32>"
      initial: 0
    - name: out0
      kind: register
      type: "bits<8>"
      initial: 0
    - name: out1
      kind: register
      type: "bits<8>"
      initial: 0
  rules:
    - name: load_weights
      condition: load_valid
      action:
        - (write w00 w_in00)
        - (write w01 w_in01)
        - (write w10 w_in10)
        - (write w11 w_in11)
    - name: mac_step
      condition: (and (not load_valid) run)
      action:
        - (write acc0 (add (read acc0) (add (mul a0 (read w00)) (mul a1 (read w10)))))
        - (write acc1 (add (read acc1) (add (mul a0 (read w01)) (mul a1 (read w11)))))
    - name: requantize
      condition: run
      action:
        - (write out0 (min (shr (mul (read acc0) scale) shift) 255))
        - (write out1 (min (shr (mul (read acc1) scale) shift) 255))
  properties:
    - name: mac_step_correct
      kind: transition
      expression:
        kind: transition
        rule: mac_step
        operand: (eq (read acc0) (add (prev acc0) (add (mul a0 (prev w00)) (mul a1
          (prev w10)))))
    - name: acc_monotonic
      kind: transition
      expression:
        kind: transition
        rule: mac_step
        operand: (and (ge (read acc0) (prev acc0)) (ge (read acc1) (prev acc1)))
    - name: weights_stationary
      kind: transition
      expression:
        kind: transition
        rule: mac_step
        operand: (and (and (eq (read w00) (prev w00)) (eq (read w01) (prev w01)))
          (and (eq (read w10) (prev w10)) (eq (read w11) (prev w11))))
    - name: out0_equals_requantized_acc0
      kind: safety
      expression:
        kind: always
        operand: (eq (read out0) (min (shr (mul (read acc0) scale) shift) 255))
  proof_obligations:
    - property: mac_step_correct
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: acc_monotonic
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: weights_stationary
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: out0_equals_requantized_acc0
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
