isir_version: "0.1"
module:
  name: vector_unit
  clocks:
    - name: clk
      edge: posedge
  resets:
    - name: rst
      polarity: active_high
      async: false
      affects: all
  inputs:
    - name: a
      direction: input
      type: "bits<32>"
    - name: b
      direction: input
      type: "bits<32>"
    - name: mask
      direction: input
      type: "bits<4>"
    - name: en
      direction: input
      type: "bool"
  outputs:
    - name: lane0
      direction: output
      type: "bits<8>"
    - name: lane1
      direction: output
      type: "bits<8>"
    - name: lane2
      direction: output
      type: "bits<8>"
    - name: lane3
      direction: output
      type: "bits<8>"
    - name: sum
      direction: output
      type: "bits<16>"
  state:
    - name: lane0
      kind: register
      type: "bits<8>"
      initial: 0
    - name: lane1
      kind: register
      type: "bits<8>"
      initial: 0
    - name: lane2
      kind: register
      type: "bits<8>"
      initial: 0
    - name: lane3
      kind: register
      type: "bits<8>"
      initial: 0
    - name: sum
      kind: register
      type: "bits<16>"
      initial: 0
  rules:
    - name: vadd_masked
      condition: en
      action:
        - (write lane0 (ite (eq (slice mask 0 0) 1) (add (slice a 7 0) (slice b 7 0)) (read lane0)))
        - (write lane1 (ite (eq (slice mask 1 1) 1) (add (slice a 15 8) (slice b 15 8)) (read lane1)))
        - (write lane2 (ite (eq (slice mask 2 2) 1) (add (slice a 23 16) (slice b 23 16)) (read lane2)))
        - (write lane3 (ite (eq (slice mask 3 3) 1) (add (slice a 31 24) (slice b 31 24)) (read lane3)))
        - (write sum (add (add (slice a 7 0) (slice a 15 8)) (add (slice a 23 16) (slice a 31 24))))
  properties:
    - name: pairwise_reduction_correct
      kind: combinational
      expression:
        kind: combinational
        operand: (add (add (slice a 7 0) (slice a 15 8)) (add (slice a 23 16) (slice a 31 24)))
        reference: (add (add (add (slice a 7 0) (slice a 15 8)) (slice a 23 16)) (slice a 31 24))
    - name: lane_add_commutative
      kind: combinational
      expression:
        kind: combinational
        operand: (add (slice a 7 0) (slice b 7 0))
        reference: (add (slice b 7 0) (slice a 7 0))
    - name: lane_mul_distributive
      kind: combinational
      expression:
        kind: combinational
        operand: (mul (slice a 7 0) (add (slice b 7 0) (slice b 15 8)))
        reference: (add (mul (slice a 7 0) (slice b 7 0)) (mul (slice a 7 0) (slice b 15 8)))
    - name: enable_excluded_middle
      kind: combinational
      expression:
        kind: combinational
        operand: (or en (not en))
        reference: true
    - name: masked_add_lane0_correct
      kind: transition
      expression:
        kind: transition
        operand: (implies (eq (slice mask 0 0) 1)
                         (eq (read lane0) (add (slice a 7 0) (slice b 7 0))))
    - name: masked_add_lane3_correct
      kind: transition
      expression:
        kind: transition
        operand: (implies (eq (slice mask 3 3) 1)
                         (eq (read lane3) (add (slice a 31 24) (slice b 31 24))))
    - name: sum_updates_to_reduction
      kind: transition
      expression:
        kind: transition
        operand: (eq (read sum)
                     (add (add (slice a 7 0) (slice a 15 8))
                          (add (slice a 23 16) (slice a 31 24))))
    - name: reduction_independent_of_mask
      kind: independence
      expression:
        kind: independence
        operand: (add (add (slice a 7 0) (slice a 15 8))
                     (add (slice a 23 16) (slice a 31 24)))
        independent_of: [mask]
    - name: reduction_independent_of_b
      kind: independence
      expression:
        kind: independence
        operand: (add (add (slice a 7 0) (slice a 15 8))
                     (add (slice a 23 16) (slice a 31 24)))
        independent_of: [b]
  proof_obligations:
    - property: pairwise_reduction_correct
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: lane_add_commutative
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: lane_mul_distributive
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: enable_excluded_middle
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: masked_add_lane0_correct
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: masked_add_lane3_correct
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: sum_updates_to_reduction
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: reduction_independent_of_mask
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: reduction_independent_of_b
      status: unproved
      engine: theorem_proving
      backend: koika
