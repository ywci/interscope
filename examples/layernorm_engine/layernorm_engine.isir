isir_version: "0.1"
module:
  name: layernorm_engine
  clocks:
    - name: clk
      edge: posedge
      period: "10ns"
  resets:
    - name: rst_n
      polarity: active_low
      async: false
      affects: all
  inputs:
    - name: x
      direction: input
      type: "bits<8>"
    - name: mean
      direction: input
      type: "bits<8>"
    - name: inv_std
      direction: input
      type: "bits<8>"
    - name: beta
      direction: input
      type: "bits<8>"
    - name: valid
      direction: input
      type: "bool"
  state:
    - name: out
      kind: register
      type: "bits<8>"
      initial: 0
  rules:
    - name: normalize
      condition: valid
      action:
        - (write out (min (add (mul (sub x mean) inv_std) beta) 255))
  properties:
    - name: out_equals_normalized
      kind: safety
      expression:
        kind: always
        operand: (eq (read out) (min (add (mul (sub x mean) inv_std) beta) 255))
    - name: out_normalizes_value
      kind: transition
      expression:
        kind: transition
        rule: normalize
        operand: (eq (read out) (min (add (mul (sub x mean) inv_std) beta) 255))
  proof_obligations:
    - property: out_normalizes_value
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: out_equals_normalized
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
