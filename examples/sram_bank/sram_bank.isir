isir_version: "0.1"
module:
  name: sram_bank
  clocks:
    - name: clk
      edge: posedge
      period: "10ns"
  resets:
    - name: rst_n
      polarity: active_low
      async: false
      affects: all
  inputs:
    - name: addr
      direction: input
      type: "bits<3>"
    - name: data_in
      direction: input
      type: "bits<8>"
    - name: write_en
      direction: input
      type: "bool"
    - name: read_en
      direction: input
      type: "bool"
  state:
    - name: mem
      kind: memory
      type:
        type: memory
        elem: "bits<8>"
        depth: 8
    - name: data_out
      kind: register
      type: "bits<8>"
      initial: 0
  rules:
    - name: write
      condition: write_en
      action:
        - (mem_write mem addr (min data_in 255))
    - name: read
      condition: read_en
      action:
        - (write data_out (mem_read mem addr))
  invariants:
    - name: data_out_bounded
      operand: (le (read data_out) 255)
  properties:
    - name: data_out_equals_mem_read
      kind: safety
      expression:
        kind: always
        operand: (eq (read data_out) (mem_read mem addr))
  proof_obligations:
    - property: data_out_equals_mem_read
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
