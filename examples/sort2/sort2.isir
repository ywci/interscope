isir_version: "0.1"
module:
  name: sort2
  clocks:
    - name: clk
      edge: posedge
  resets:
    - name: rst
      polarity: active_high
      async: false
      affects: all
  inputs:
    - name: a_in
      direction: input
      type: "bits<8>"
    - name: b_in
      direction: input
      type: "bits<8>"
    - name: load
      direction: input
      type: "bool"
  outputs:
    - name: lo
      direction: output
      type: "bits<8>"
    - name: hi
      direction: output
      type: "bits<8>"
  state:
    - name: lo
      kind: register
      type: "bits<8>"
      initial: 0
    - name: hi
      kind: register
      type: "bits<8>"
      initial: 0

  functions:
    - name: min2
      params: [{name: a, type: "bits<8>"}, {name: b, type: "bits<8>"}]
      return: "bits<8>"
      body: (ite (le a b) a b)
    - name: max2
      params: [{name: a, type: "bits<8>"}, {name: b, type: "bits<8>"}]
      return: "bits<8>"
      body: (ite (le a b) b a)

  rules:
    - name: sort
      condition: load
      action:
        - (write lo (ite (le a_in b_in) a_in b_in))
        - (write hi (ite (le a_in b_in) b_in a_in))
  properties:
    - name: sorted
      kind: safety
      expression:
        kind: always
        operand: (le (read lo) (read hi))
    - name: lo_hi_correct
      kind: transition
      expression:
        kind: transition
        rule: sort
        operand: (and (eq (read lo) (min2 a_in b_in))
                      (eq (read hi) (max2 a_in b_in)))
  proof_obligations:
    - property: sorted
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: lo_hi_correct
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: sorted
      engine: model_checking
