isir_version: "0.1"
module:
  name: calculator
  clocks:
    - name: clk
      edge: posedge
      period: "10ns"
  resets:
    - name: rst_n
      polarity: active_low
      async: false
      affects: all
  inputs:
    - name: opcode
      direction: input
      type: "bits<2>"
      protocol: fixed_cycle
    - name: data_in
      direction: input
      type: "bits<8>"
      protocol: fixed_cycle
  outputs:
    - name: top
      direction: output
      type: "bits<8>"
      protocol: fixed_cycle
    - name: error
      direction: output
      type: "bool"
      protocol: fixed_cycle
  state:
    - name: sp
      kind: register
      type: "bits<4>"
      initial: 0
    - name: top
      kind: register
      type: "bits<8>"
      initial: 0
    - name: error
      kind: register
      type: "bool"
      initial: false
  rules:
    - name: execute
      condition: "true"
      action:
        - (write top (ite (eq (read opcode) 0) data_in (read top)))
        - (write error (or (and (eq (read opcode) 0) (eq (read sp) 8)) (or (and (eq
          (read opcode) 3) (eq (read sp) 0)) (and (or (eq (read opcode) 1) (eq (read
          opcode) 2)) (lt (read sp) 2)))))
        - (write sp (ite (eq (read opcode) 0) (ite (lt (read sp) 8) (add (read sp)
          1) (read sp)) (ite (eq (read opcode) 3) (ite (gt (read sp) 0) (sub (read
          sp) 1) (read sp)) (ite (or (eq (read opcode) 1) (eq (read opcode) 2)) (ite
          (ge (read sp) 2) (sub (read sp) 1) (read sp)) (read sp)))))
  properties:
    - name: error_iff_invalid_op
      kind: safety
      expression:
        kind: always
        operand: (eq error (or (and (eq opcode 0) (eq (read sp) 8)) (or (and (eq opcode
          3) (eq (read sp) 0)) (and (or (eq opcode 1) (eq opcode 2)) (lt (read sp)
          2)))))
    - name: error_on_push_full
      kind: transition
      expression:
        kind: transition
        rule: execute
        operand: (implies (and (eq opcode 0) (eq (prev sp) 8)) (eq error True))
    - name: error_on_pop_empty
      kind: transition
      expression:
        kind: transition
        rule: execute
        operand: (implies (and (eq opcode 3) (eq (prev sp) 0)) (eq error True))
  proof_obligations:
    - property: error_on_push_full
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: error_on_pop_empty
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: error_iff_invalid_op
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: error_iff_invalid_op
      engine: model_checking
