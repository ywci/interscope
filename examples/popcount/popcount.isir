isir_version: "0.1"
module:
  name: popcount
  clocks:
    - name: clk
      edge: posedge
  resets:
    - name: rst
      polarity: active_high
      async: false
      affects: all
  inputs:
    - name: start
      direction: input
      type: "bool"
    - name: data
      direction: input
      type: "bits<8>"
  outputs:
    - name: count
      direction: output
      type: "bits<4>"
    - name: done
      direction: output
      type: "bool"
  state:
    - name: value
      kind: register
      type: "bits<8>"
      initial: 0
    - name: count
      kind: register
      type: "bits<4>"
      initial: 0
    - name: index
      kind: register
      type: "bits<4>"
      initial: 0
    - name: done
      kind: register
      type: "bool"
      initial: false
  rules:
    - name: load
      condition: start
      action:
        - (write value (read data))
        - (write count 0)
        - (write index 0)
        - (write done false)
    - name: count_bit
      condition: (and (not (read done)) (and (lt (read index) 8) (eq (mod (read value)
        2) 1)))
      action:
        - (write count (add (read count) 1))
        - (write value (div (read value) 2))
        - (write index (add (read index) 1))
    - name: shift_bit
      condition: (and (not (read done)) (and (lt (read index) 8) (eq (mod (read value)
        2) 0)))
      action:
        - (write value (div (read value) 2))
        - (write index (add (read index) 1))
    - name: finish
      condition: (and (not (read done)) (ge (read index) 8))
      action:
        - (write done true)
  properties:
    - name: count_le_index
      kind: safety
      expression:
        kind: always
        operand: (le count (read index))
    - name: done_iff_index_eq_8
      kind: safety
      expression:
        kind: always
        operand: (eq done (eq (read index) 8))
    - name: popcount_loads_value
      kind: transition
      expression:
        kind: transition
        rule: load
        operand: (and (eq (read value) (prev data)) (and (eq count 0) (and (eq (read
          index) 0) (eq done False))))
    - name: set_bit_counted
      kind: transition
      expression:
        kind: transition
        rule: count_bit
        operand: (and (eq count (add (prev count) 1)) (and (eq (read value) (div (prev
          value) 2)) (eq (read index) (add (prev index) 1))))
    - name: clear_bit_shifted
      kind: transition
      expression:
        kind: transition
        rule: shift_bit
        operand: (and (eq (read value) (div (prev value) 2)) (eq (read index) (add
          (prev index) 1)))
    - name: popcount_finishes
      kind: transition
      expression:
        kind: transition
        rule: finish
        operand: (eq done True)
  proof_obligations:
    - property: popcount_loads_value
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: set_bit_counted
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: count_le_index
      engine: model_checking
    - property: clear_bit_shifted
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: popcount_finishes
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: count_le_index
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: done_iff_index_eq_8
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
