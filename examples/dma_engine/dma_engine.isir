isir_version: "0.1"
module:
  name: dma_engine
  clocks:
    - name: clk
      edge: posedge
      period: "10ns"
  resets:
    - name: rst_n
      polarity: active_low
      async: false
      affects: all
  inputs:
    - name: start
      direction: input
      type: "bool"
    - name: direction
      direction: input
      type: "bool"
    - name: base_addr
      direction: input
      type: "bits<8>"
    - name: burst_len
      direction: input
      type: "bits<4>"
  state:
    - name: addr
      kind: register
      type: "bits<8>"
      initial: 0
    - name: remaining
      kind: register
      type: "bits<4>"
      initial: 0
    - name: is_store
      kind: register
      type: "bool"
      initial: false
    - name: busy
      kind: register
      type: "bool"
      initial: false
  rules:
    - name: start_burst
      condition: (and start (not (read busy)))
      action:
        - (write addr (min base_addr 255))
        - (write remaining (min burst_len 15))
        - (write is_store direction)
        - (write busy true)
    - name: burst_step
      condition: (and (read busy) (neq (read remaining) 0))
      action:
        - (write addr (min (add (read addr) 1) 255))
        - (write remaining (sub (read remaining) 1))
    - name: complete_burst
      condition: (and (read busy) (eq (read remaining) 0))
      action:
        - (write busy false)
  properties:
    - name: busy_iff_remaining_nonzero
      kind: safety
      expression:
        kind: always
        operand: (eq (read busy) (neq (read remaining) 0))
    - name: burst_initializes
      kind: transition
      expression:
        kind: transition
        rule: start_burst
        operand: (and (eq (read addr) (min base_addr 255)) (and (eq (read remaining)
          (min burst_len 15)) (and (eq (read is_store) direction) (eq (read busy)
          True))))
    - name: burst_advances
      kind: transition
      expression:
        kind: transition
        rule: burst_step
        operand: (and (eq (read addr) (min (add (prev addr) 1) 255)) (eq (read remaining)
          (sub (prev remaining) 1)))
    - name: burst_completes
      kind: transition
      expression:
        kind: transition
        rule: complete_burst
        operand: (eq (read busy) False)
  proof_obligations:
    - property: burst_initializes
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: burst_advances
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: burst_completes
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: busy_iff_remaining_nonzero
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
