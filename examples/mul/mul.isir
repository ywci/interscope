isir_version: "0.1"
module:
  name: mul
  clocks:
    - name: clk
      edge: posedge
  resets:
    - name: rst
      polarity: active_high
      async: false
      affects: all
  inputs:
    - name: start
      direction: input
      type: "bool"
    - name: x
      direction: input
      type: "bits<16>"
    - name: y
      direction: input
      type: "bits<16>"
    - name: z
      direction: input
      type: "bits<16>"
  outputs:
    - name: product
      direction: output
      type: "bits<32>"
    - name: done
      direction: output
      type: "bool"
  state:
    - name: multiplicand
      kind: register
      type: "bits<16>"
      initial: 0
    - name: multiplier
      kind: register
      type: "bits<16>"
      initial: 0
    - name: acc
      kind: register
      type: "bits<32>"
      initial: 0
    - name: count
      kind: register
      type: "bits<5>"
      initial: 0
    - name: done
      kind: register
      type: "bool"
      initial: false
    - name: product
      kind: register
      type: "bits<32>"
      initial: 0

  # Combinational reference functions for the multiplier datapath.
  functions:
    - name: mul_exact
      params: [{name: a, type: "bits<16>"}, {name: b, type: "bits<16>"}]
      return: "bits<32>"
      body: (mul a b)
    - name: mul_truncated_result
      params: [{name: a, type: "bits<16>"}, {name: b, type: "bits<16>"}]
      return: "bits<16>"
      body: (slice (mul_exact a b) 15 0)
    - name: mul_truncated_ovf
      params: [{name: a, type: "bits<16>"}, {name: b, type: "bits<16>"}]
      return: "bool"
      body: (neq (slice (mul_exact a b) 31 16) 0)

  rules:
    - name: load
      condition: start
      action:
        - (write multiplicand (read x))
        - (write multiplier (read y))
        - (write acc 0)
        - (write count 0)
        - (write done false)
    - name: add_step
      condition: (and (not (read done)) (and (lt (read count) 16) (eq (mod (read multiplier) 2) 1)))
      action:
        - (write acc (add (read acc) (read multiplicand)))
        - (write multiplier (div (read multiplier) 2))
        - (write count (add (read count) 1))
    - name: shift_step
      condition: (and (not (read done)) (and (lt (read count) 16) (eq (mod (read multiplier) 2) 0)))
      action:
        - (write multiplier (div (read multiplier) 2))
        - (write count (add (read count) 1))
    - name: finish
      condition: (and (not (read done)) (ge (read count) 16))
      action:
        - (write done true)
        - (write product (read acc))
  properties:
    - name: count_in_range
      kind: safety
      expression:
        kind: always
        operand: (and (ge (read count) 0) (le (read count) 16))
    - name: acc_nonneg
      kind: safety
      expression:
        kind: always
        operand: (ge (read acc) 0)
    - name: mul_commutative
      kind: combinational
      expression:
        kind: combinational
        operand: (mul_exact x y)
        reference: (mul_exact y x)
    - name: mul_distributive
      kind: combinational
      expression:
        kind: combinational
        operand: (mul_exact x (add y z))
        reference: (add (mul_exact x y) (mul_exact x z))
    - name: mul_zero
      kind: combinational
      expression:
        kind: combinational
        operand: (mul_exact x 0)
        reference: 0
    - name: mul_one
      kind: combinational
      expression:
        kind: combinational
        operand: (mul_exact x 1)
        reference: x
    - name: truncation_definitional
      kind: combinational
      expression:
        kind: combinational
        operand: (mul_truncated_result x y)
        reference: (slice (mul_exact x y) 15 0)
    - name: overflow_definitional
      kind: combinational
      expression:
        kind: combinational
        operand: (mul_truncated_ovf x y)
        reference: (neq (slice (mul_exact x y) 31 16) 0)
    - name: unsigned_max_bound
      kind: combinational
      assumes:
        - (and (le x 255) (le y 255))
      expression:
        kind: combinational
        operand: (le (mul_exact x y) 65025)
        reference: true
  proof_obligations:
    - property: count_in_range
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: acc_nonneg
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: mul_commutative
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: mul_commutative
      status: unproved
      engine: theorem_proving
      backend: acl2
    - property: mul_distributive
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: mul_distributive
      status: unproved
      engine: theorem_proving
      backend: acl2
    - property: mul_zero
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: mul_zero
      status: unproved
      engine: theorem_proving
      backend: acl2
    - property: mul_one
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: mul_one
      status: unproved
      engine: theorem_proving
      backend: acl2
    - property: truncation_definitional
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: truncation_definitional
      status: unproved
      engine: theorem_proving
      backend: acl2
    - property: overflow_definitional
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: overflow_definitional
      status: unproved
      engine: theorem_proving
      backend: acl2
    - property: unsigned_max_bound
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: unsigned_max_bound
      status: unproved
      engine: theorem_proving
      backend: acl2
    - property: count_in_range
      engine: model_checking
