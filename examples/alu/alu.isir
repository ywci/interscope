isir_version: "0.1"
module:
  name: alu
  clocks:
    - name: clk
      edge: posedge
      period: "10ns"
  resets:
    - name: rst_n
      polarity: active_low
      async: false
      affects: all

  inputs:
    - name: op
      direction: input
      type: "bits<3>"
      protocol: fixed_cycle
    - name: a
      direction: input
      type: "bits<8>"
      protocol: fixed_cycle
    - name: b
      direction: input
      type: "bits<8>"
      protocol: fixed_cycle

  outputs:
    - name: result
      direction: output
      type: "bits<8>"
      protocol: fixed_cycle
    - name: zero
      direction: output
      type: "bool"
      protocol: fixed_cycle
    - name: overflow
      direction: output
      type: "bool"
      protocol: fixed_cycle

  state:
    - name: result_reg
      kind: register
      type: "bits<8>"
      initial: 0
    - name: zero_reg
      kind: register
      type: "bool"
      initial: false
    - name: overflow_reg
      kind: register
      type: "bool"
      initial: false
    - name: valid
      kind: register
      type: "bool"
      initial: false
    - name: op_reg
      kind: register
      type: "bits<3>"
      initial: 0
    - name: a_reg
      kind: register
      type: "bits<8>"
      initial: 0
    - name: b_reg
      kind: register
      type: "bits<8>"
      initial: 0

  rules:
    - name: load_inputs
      condition: "true"
      priority: 0
      action:
        - (write op_reg (read op))
        - (write a_reg (read a))
        - (write b_reg (read b))

    - name: execute
      condition: "true"
      priority: 1
      action:
        - (write result_reg
            (ite (eq (read op_reg) 0) (add (read a_reg) (read b_reg))
            (ite (eq (read op_reg) 1) (sub (read a_reg) (read b_reg))
            (ite (eq (read op_reg) 2) (and (read a_reg) (read b_reg))
            (ite (eq (read op_reg) 3) (or (read a_reg) (read b_reg))
            (ite (eq (read op_reg) 4)
                 (ite (eq (read a_reg) (read b_reg)) 0
                      (ite (lt (read a_reg) (read b_reg)) 1 2))
            (ite (eq (read op_reg) 5) (xor (read a_reg) (read b_reg))
            (ite (eq (read op_reg) 6) (shl (read a_reg) (slice (read b_reg) 2 0))
            (ite (eq (read op_reg) 7) (shr (read a_reg) (slice (read b_reg) 2 0))
                 0)))))))))
        - (write overflow_reg
            (ite (eq (read op_reg) 0)
                 (and (eq (slice (read a_reg) 7 7) (slice (read b_reg) 7 7))
                      (neq (slice (read a_reg) 7 7) (slice (add (read a_reg) (read b_reg)) 7 7)))
                 (ite (eq (read op_reg) 1)
                      (and (neq (slice (read a_reg) 7 7) (slice (read b_reg) 7 7))
                           (eq (slice (read a_reg) 7 7) (slice (sub (read a_reg) (read b_reg)) 7 7)))
                      false)))
        - (write zero_reg
            (eq (ite (eq (read op_reg) 0) (add (read a_reg) (read b_reg))
                (ite (eq (read op_reg) 1) (sub (read a_reg) (read b_reg))
                (ite (eq (read op_reg) 2) (and (read a_reg) (read b_reg))
                (ite (eq (read op_reg) 3) (or (read a_reg) (read b_reg))
                (ite (eq (read op_reg) 4)
                     (ite (eq (read a_reg) (read b_reg)) 0
                          (ite (lt (read a_reg) (read b_reg)) 1 2))
                (ite (eq (read op_reg) 5) (xor (read a_reg) (read b_reg))
                (ite (eq (read op_reg) 6) (shl (read a_reg) (slice (read b_reg) 2 0))
                (ite (eq (read op_reg) 7) (shr (read a_reg) (slice (read b_reg) 2 0))
                     0))))))))
                0))
        - (write valid true)

  properties:
    - name: zero_flag_correct
      kind: safety
      expression:
        kind: always
        operand: (implies (read valid)
                          (eq (read zero_reg) (eq (read result_reg) 0)))

    - name: add_overflow_correct
      kind: safety
      expression:
        kind: always
        operand: (implies (eq (read op_reg) 0)
                          (eq (read overflow_reg)
                              (and (eq (slice (read a_reg) 7 7) (slice (read b_reg) 7 7))
                                   (neq (slice (read a_reg) 7 7) (slice (add (read a_reg) (read b_reg)) 7 7)))))

    - name: sub_overflow_correct
      kind: safety
      expression:
        kind: always
        operand: (implies (eq (read op_reg) 1)
                          (eq (read overflow_reg)
                              (and (neq (slice (read a_reg) 7 7) (slice (read b_reg) 7 7))
                                   (eq (slice (read a_reg) 7 7) (slice (sub (read a_reg) (read b_reg)) 7 7)))))

    # New challenging properties to test backtracking
    - name: overflow_implies_result_neq_sum
      kind: safety
      expression:
        kind: always
        operand: (implies (and (read valid) (and (eq (read op_reg) 0) (read overflow_reg)))
                          (neq (read result_reg)
                               (add (read a_reg) (read b_reg))))

    - name: sub_overflow_implies_result_neq_diff
      kind: safety
      expression:
        kind: always
        operand: (implies (and (read valid) (and (eq (read op_reg) 1) (read overflow_reg)))
                          (neq (read result_reg)
                               (sub (read a_reg) (read b_reg))))

    - name: result_reg_self
      kind: safety
      expression:
        kind: always
        operand: (eq (read result_reg) (read result_reg))
    - name: zero_reg_is_bool
      kind: safety
      expression:
        kind: always
        operand: (or (eq (read zero_reg) true) (eq (read zero_reg) false))
    - name: overflow_reg_is_bool
      kind: safety
      expression:
        kind: always
        operand: (or (eq (read overflow_reg) true) (eq (read overflow_reg) false))
    - name: valid_is_bool
      kind: safety
      expression:
        kind: always
        operand: (or (eq (read valid) true) (eq (read valid) false))

    # --- combinational correctness (golden reference per opcode) ---
    # Each operand mirrors the `execute` rule's result datapath with the
    # opcode pinned to a literal; the reference is the golden expression.
    - name: add_correctness
      kind: combinational
      expression:
        kind: combinational
        operand: (ite (eq 0 0) (add a b) (ite (eq 0 1) (sub a b) (ite (eq 0 2) (and a b) (ite (eq 0 3) (or a b) (ite (eq 0 4) (ite (eq a b) 0 (ite (lt a b) 1 2)) (ite (eq 0 5) (xor a b) (ite (eq 0 6) (shl a (slice b 2 0)) (ite (eq 0 7) (shr a (slice b 2 0)) 0))))))))
        reference: (add a b)

    - name: sub_correctness
      kind: combinational
      expression:
        kind: combinational
        operand: (ite (eq 1 0) (add a b) (ite (eq 1 1) (sub a b) (ite (eq 1 2) (and a b) (ite (eq 1 3) (or a b) (ite (eq 1 4) (ite (eq a b) 0 (ite (lt a b) 1 2)) (ite (eq 1 5) (xor a b) (ite (eq 1 6) (shl a (slice b 2 0)) (ite (eq 1 7) (shr a (slice b 2 0)) 0))))))))
        reference: (sub a b)

    - name: and_correctness
      kind: combinational
      expression:
        kind: combinational
        operand: (ite (eq 2 0) (add a b) (ite (eq 2 1) (sub a b) (ite (eq 2 2) (and a b) (ite (eq 2 3) (or a b) (ite (eq 2 4) (ite (eq a b) 0 (ite (lt a b) 1 2)) (ite (eq 2 5) (xor a b) (ite (eq 2 6) (shl a (slice b 2 0)) (ite (eq 2 7) (shr a (slice b 2 0)) 0))))))))
        reference: (and a b)

    - name: or_correctness
      kind: combinational
      expression:
        kind: combinational
        operand: (ite (eq 3 0) (add a b) (ite (eq 3 1) (sub a b) (ite (eq 3 2) (and a b) (ite (eq 3 3) (or a b) (ite (eq 3 4) (ite (eq a b) 0 (ite (lt a b) 1 2)) (ite (eq 3 5) (xor a b) (ite (eq 3 6) (shl a (slice b 2 0)) (ite (eq 3 7) (shr a (slice b 2 0)) 0))))))))
        reference: (or a b)

    - name: cmp_correctness
      kind: combinational
      expression:
        kind: combinational
        operand: (ite (eq 4 0) (add a b) (ite (eq 4 1) (sub a b) (ite (eq 4 2) (and a b) (ite (eq 4 3) (or a b) (ite (eq 4 4) (ite (eq a b) 0 (ite (lt a b) 1 2)) (ite (eq 4 5) (xor a b) (ite (eq 4 6) (shl a (slice b 2 0)) (ite (eq 4 7) (shr a (slice b 2 0)) 0))))))))
        reference: (ite (eq a b) 0 (ite (lt a b) 1 2))

    - name: xor_correctness
      kind: combinational
      expression:
        kind: combinational
        operand: (ite (eq 5 0) (add a b) (ite (eq 5 1) (sub a b) (ite (eq 5 2) (and a b) (ite (eq 5 3) (or a b) (ite (eq 5 4) (ite (eq a b) 0 (ite (lt a b) 1 2)) (ite (eq 5 5) (xor a b) (ite (eq 5 6) (shl a (slice b 2 0)) (ite (eq 5 7) (shr a (slice b 2 0)) 0))))))))
        reference: (xor a b)

    - name: shl_correctness
      kind: combinational
      expression:
        kind: combinational
        operand: (ite (eq 6 0) (add a b) (ite (eq 6 1) (sub a b) (ite (eq 6 2) (and a b) (ite (eq 6 3) (or a b) (ite (eq 6 4) (ite (eq a b) 0 (ite (lt a b) 1 2)) (ite (eq 6 5) (xor a b) (ite (eq 6 6) (shl a (slice b 2 0)) (ite (eq 6 7) (shr a (slice b 2 0)) 0))))))))
        reference: (shl a (slice b 2 0))

    - name: shr_correctness
      kind: combinational
      expression:
        kind: combinational
        operand: (ite (eq 7 0) (add a b) (ite (eq 7 1) (sub a b) (ite (eq 7 2) (and a b) (ite (eq 7 3) (or a b) (ite (eq 7 4) (ite (eq a b) 0 (ite (lt a b) 1 2)) (ite (eq 7 5) (xor a b) (ite (eq 7 6) (shl a (slice b 2 0)) (ite (eq 7 7) (shr a (slice b 2 0)) 0))))))))
        reference: (shr a (slice b 2 0))

  proof_obligations:
    - property: zero_flag_correct
      status: unproved
      engine: theorem_proving
      backend: koika
      metadata:
        coq_tactic_hints:
          - "induction"
          - "simpl"
          - "auto"
          - "lia"
    - property: add_correctness
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: add_correctness
      status: unproved
      engine: theorem_proving
      backend: acl2
    - property: sub_correctness
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: sub_correctness
      status: unproved
      engine: theorem_proving
      backend: acl2
    - property: and_correctness
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: and_correctness
      status: unproved
      engine: theorem_proving
      backend: acl2
    - property: or_correctness
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: or_correctness
      status: unproved
      engine: theorem_proving
      backend: acl2
    - property: cmp_correctness
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: cmp_correctness
      status: unproved
      engine: theorem_proving
      backend: acl2
    - property: xor_correctness
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: xor_correctness
      status: unproved
      engine: theorem_proving
      backend: acl2
    - property: shl_correctness
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: shl_correctness
      status: unproved
      engine: theorem_proving
      backend: acl2
    - property: shr_correctness
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: shr_correctness
      status: unproved
      engine: theorem_proving
      backend: acl2
    # NOTE: overflow_implies_result_neq_sum / sub_overflow_implies_result_neq_diff
    # are deliberately NOT theorem_proving obligations. Under the current
    # lowering (bits<N> -> unbounded nat, add/sub -> Nat.+/-), result_reg is
    # definitionally equal to add/sub(a_reg, b_reg), so "result != add(a,b)" is
    # unsatisfiable. The definitional add_overflow_correct / sub_overflow_correct
    # properties above express the intended overflow contract.
    # Existing simple ACL2 and model-checking obligations (unchanged)
    - property: result_reg_self
      status: unproved
      engine: theorem_proving
      backend: acl2
    - property: zero_reg_is_bool
      status: unproved
      engine: theorem_proving
      backend: acl2
    - property: overflow_reg_is_bool
      status: unproved
      engine: theorem_proving
      backend: acl2
    - property: valid_is_bool
      status: unproved
      engine: theorem_proving
      backend: acl2
    - property: zero_flag_correct
      engine: model_checking
    - property: result_reg_self
      engine: model_checking
    - property: zero_reg_is_bool
      engine: model_checking
    - property: overflow_reg_is_bool
      engine: model_checking
    - property: valid_is_bool
      engine: model_checking