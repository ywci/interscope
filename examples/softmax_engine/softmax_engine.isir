isir_version: "0.1"
module:
  name: softmax_engine
  clocks:
    - name: clk
      edge: posedge
      period: "10ns"
  resets:
    - name: rst_n
      polarity: active_low
      async: false
      affects: all
  inputs:
    - name: x
      direction: input
      type: "bits<8>"
    - name: valid
      direction: input
      type: "bool"
  components:
    - name: max_finder
      module: "examples/min_max_finder/min_max_finder.isir"
      lift_properties: false
      port_map:
        valid: valid
        data: x
        max_val: row_max
  state:
    - name: row_max
      kind: register
      type: "bits<8>"
      initial: 0
    - name: out
      kind: register
      type: "bits<8>"
      initial: 0
  rules:
    - name: shift
      condition: valid
      action:
        - (write out (min (sub x (read row_max)) 255))
  properties:
    - name: out_equals_x_minus_row_max
      kind: safety
      expression:
        kind: always
        operand: (eq (read out) (min (sub x (read row_max)) 255))
    - name: out_subtracts_row_max
      kind: transition
      expression:
        kind: transition
        rule: shift
        operand: (eq (read out) (min (sub x (prev row_max)) 255))
  proof_obligations:
    - property: out_subtracts_row_max
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: out_equals_x_minus_row_max
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
