isir_version: "0.1"
module:
  name: core_comp
  parameters:
    - name: me
      type: int
      default: 0
  clocks:
    - name: clk
      edge: posedge
  resets:
    - name: rst
      polarity: active_high
      async: false
      affects: all
  inputs:
    - name: req_core
      direction: input
      type: "bits<4>"
    - name: issue_valid
      direction: input
      type: "bool"
    - name: rd
      direction: input
      type: "bits<2>"
    - name: op
      direction: input
      type: "bool"
    - name: store
      direction: input
      type: "bool"
    - name: a
      direction: input
      type: "bits<8>"
    - name: b
      direction: input
      type: "bits<8>"
    - name: alu_op
      direction: input
      type: "bits<3>"
    - name: addr
      direction: input
      type: "bits<4>"
    - name: d_is_physical
      direction: input
      type: "bool"     # true = PIPT special load (PTW); false = VIPT normal load
    - name: taken
      direction: input
      type: "bool"     # branch outcome (feeds fetch's BPU)
    - name: req_write
      direction: input
      type: "bool"
    - name: req_addr
      direction: input
      type: "bits<4>"
    - name: req_data
      direction: input
      type: "bits<8>"
    - name: stall
      direction: input
      type: "bool"
    - name: branch_target
      direction: input
      type: "bits<4>"
    - name: araddr
      direction: input
      type: "bits<4>"
    - name: arvalid
      direction: input
      type: "bool"
    - name: awaddr
      direction: input
      type: "bits<4>"
    - name: awvalid
      direction: input
      type: "bool"
    - name: wdata
      direction: input
      type: "bits<8>"
    - name: wvalid
      direction: input
      type: "bool"
    - name: va
      direction: input
      type: "bits<32>"
    - name: alloc_valid
      direction: input
      type: "bool"
    - name: id
      direction: input
      type: "bits<2>"
    - name: release0
      direction: input
      type: "bool"
    - name: release1
      direction: input
      type: "bool"
  components:
    # MMU: instruction TLB + data TLB + shared page-table walker.
    - name: mmu
      module: "examples/mmu_comp/mmu_comp.isir"
      lift_properties: false
      port_map: {i_vpn: pc_signal, d_vpn: addr, va: va, i_ppn: i_pa_signal, d_ppn: pa_signal, i_miss: i_miss_signal, d_miss: d_miss_signal, miss_signal: tlb_miss_signal, ptw_mem_addr: ptw_mem_addr_signal, ptw_active: ptw_active_signal, ptw_mem_data: ptw_mem_data_signal}
    # Fetch (with internal BPU). Its pc is exposed as pc_signal; its instruction
    # fetch uses the MMU-translated i_pa_signal (physical).
    - name: fetch
      module: "examples/fetch_comp/fetch_comp.isir"
      lift_properties: false
      port_map: {stall: stall, taken: taken, branch_target: branch_target, pc: pc_signal}
    - name: ooo
      module: "examples/ooo_comp/ooo_comp.isir"
      lift_properties: false
      port_map: {issue_valid: issue_valid, rd: rd, op: op, alu_op: alu_op, store: store, a: a, b: b, addr: addr}
    # Two-level cache: L1I fed by the translated instruction PA, L1D fed by the
    # translated data PA.
    - name: cache
      module: "examples/cache_comp/cache_comp.isir"
      parameters: {me: $me}
      lift_properties: false
      port_map: {i_addr: i_pa_signal, d_core: req_core, d_write: l1d_write_signal, d_addr: l1d_addr_signal, d_vpn: d_vpn_signal, d_is_physical: l1d_phys_signal, d_data: req_data, mshr_release0: release0, mshr_release1: release1, l2_miss_valid: miss_valid_signal, l2_miss_addr: miss_addr_signal, l1d_rdata: ptw_mem_data_signal}
    - name: axi_mem
      module: "examples/axi_mem/axi_mem.isir"
      lift_properties: false
      port_map: {araddr: miss_addr_signal, arvalid: miss_valid_signal, awaddr: awaddr, awvalid: awvalid, wdata: wdata, wvalid: wvalid}
  state:
    # Shared signal carrying the fetch stage's program counter.
    - name: pc_signal
      kind: register
      type: "bits<4>"
      initial: 0
    # Translated addresses from the MMU.
    - name: i_pa_signal
      kind: register
      type: "bits<4>"
      initial: 0
    - name: pa_signal
      kind: register
      type: "bits<4>"
      initial: 0
    # Data VA page-offset (VIPT index for the L1D).
    - name: d_vpn_signal
      kind: register
      type: "bits<2>"
      initial: 0
    # PTW memory interface (physical read -> L1D in PIPT mode).
    - name: ptw_mem_addr_signal
      kind: register
      type: "bits<4>"
      initial: 0
    - name: ptw_active_signal
      kind: register
      type: "bool"
      initial: false
    - name: ptw_mem_data_signal
      kind: register
      type: "bits<8>"
      initial: 0
    # Multiplexed L1D request (LSU VIPT vs PTW PIPT).
    - name: l1d_addr_signal
      kind: register
      type: "bits<4>"
      initial: 0
    - name: l1d_write_signal
      kind: register
      type: "bool"
      initial: false
    - name: l1d_phys_signal
      kind: register
      type: "bool"
      initial: false
    # MMU miss flags.
    - name: i_miss_signal
      kind: register
      type: "bool"
      initial: false
    - name: d_miss_signal
      kind: register
      type: "bool"
      initial: false
    - name: tlb_miss_signal
      kind: register
      type: "bool"
      initial: false
    # MSHR / AXI miss signals.
    - name: miss_valid_signal
      kind: register
      type: "bool"
      initial: false
    - name: miss_addr_signal
      kind: register
      type: "bits<4>"
      initial: 0
    - name: pc
      kind: register
      type: "bits<4>"
      initial: 0
  rules:
    # Data VA page-offset = VIPT index (== PA offset within a page).
    - name: slice_d_vpn
      condition: "true"
      action:
        - (write d_vpn_signal (slice addr 1 0))
    # Multiplex the L1D request: PTW physical read (PIPT) vs LSU data access (VIPT).
    - name: mux_l1d_addr
      condition: "true"
      action:
        - (write l1d_addr_signal (ite (read ptw_active_signal) (read ptw_mem_addr_signal) pa_signal))
    - name: mux_l1d_write
      condition: "true"
      action:
        - (write l1d_write_signal (and (not (read ptw_active_signal)) req_write))
    - name: mux_l1d_phys
      condition: "true"
      action:
        - (write l1d_phys_signal (or (read ptw_active_signal) d_is_physical))
    - name: retire
      condition: (eq req_core $me)
      action:
        - (write pc (add (read pc) 1))
  properties:
    - name: pc_increments
      kind: transition
      expression:
        kind: transition
        rule: retire
        operand: (eq (read pc) (add (prev pc) 1))
    - name: itlb_hit_sets_i_pa
      kind: transition
      expression:
        kind: transition
        rule: mmu_itlb_hit0
        operand: (eq (read i_pa_signal) (read mmu_itlb_way0_ppn))
    - name: dtlb_hit_sets_pa
      kind: transition
      expression:
        kind: transition
        rule: mmu_dtlb_hit0
        operand: (eq (read pa_signal) (read mmu_dtlb_way0_ppn))
    - name: l2_miss_issues_axi
      kind: transition
      expression:
        kind: transition
        rule: cache_l2_read_miss0
        operand: (eq (read miss_valid_signal) true)
    - name: tlb_miss_triggers_ptw
      kind: transition
      expression:
        kind: transition
        rule: mmu_combine_miss
        operand: (eq (read tlb_miss_signal) (or (read i_miss_signal) (read d_miss_signal)))
    - name: ptw_read_is_pipt
      kind: transition
      expression:
        kind: transition
        rule: mux_l1d_phys
        operand: (implies (read ptw_active_signal) (eq (read l1d_phys_signal) true))
  proof_obligations:
    - property: pc_increments
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: itlb_hit_sets_i_pa
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: dtlb_hit_sets_pa
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: l2_miss_issues_axi
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: tlb_miss_triggers_ptw
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: ptw_read_is_pipt
      status: unproved
      engine: theorem_proving
      backend: koika
