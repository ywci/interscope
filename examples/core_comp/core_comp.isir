isir_version: "0.1"
module:
  name: core_comp
  parameters:
    - name: me
      type: int
      default: 0
  clocks:
    - name: clk
      edge: posedge
  resets:
    - name: rst
      polarity: active_high
      async: false
      affects: all
  inputs:
    - name: req_core
      direction: input
      type: "bits<4>"
    - name: issue_valid
      direction: input
      type: "bool"
    - name: rd
      direction: input
      type: "bits<2>"
    - name: op
      direction: input
      type: "bool"
    - name: store
      direction: input
      type: "bool"
    - name: a
      direction: input
      type: "bits<8>"
    - name: b
      direction: input
      type: "bits<8>"
    - name: alu_op
      direction: input
      type: "bits<3>"
    - name: addr
      direction: input
      type: "bits<4>"
    - name: taken
      direction: input
      type: "bool"     # branch outcome (feeds fetch's BPU)
    - name: req_write
      direction: input
      type: "bool"
    - name: req_addr
      direction: input
      type: "bits<4>"
    - name: req_data
      direction: input
      type: "bits<8>"
    - name: stall
      direction: input
      type: "bool"
    - name: branch_target
      direction: input
      type: "bits<4>"
    - name: araddr
      direction: input
      type: "bits<4>"
    - name: arvalid
      direction: input
      type: "bool"
    - name: awaddr
      direction: input
      type: "bits<4>"
    - name: awvalid
      direction: input
      type: "bool"
    - name: wdata
      direction: input
      type: "bits<8>"
    - name: wvalid
      direction: input
      type: "bool"
    - name: vpn
      direction: input
      type: "bits<4>"
    - name: ppn_in
      direction: input
      type: "bits<4>"
    - name: va
      direction: input
      type: "bits<32>"
    - name: alloc_valid
      direction: input
      type: "bool"
    - name: id
      direction: input
      type: "bits<2>"
    - name: release0
      direction: input
      type: "bool"
    - name: release1
      direction: input
      type: "bool"
  components:
    # TLB (leaf) + MSHR miss queue (container).
    - name: tlb
      module: "examples/tlb/tlb.isir"
      lift_properties: false
      port_map: {vpn: vpn, ppn_in: tlb_ppn_in, tlb_ppn: pa_signal, miss: tlb_miss_signal}
    - name: ptw
      module: "examples/ptw/ptw.isir"
      lift_properties: false
      port_map: {va: va, start: tlb_miss_signal, result_ppn: ptw_ppn_signal}
    - name: mshr
      module: "examples/mshr_comp/mshr_comp.isir"
      lift_properties: false
      port_map: {alloc_valid: miss_valid_signal, id: id, addr: miss_addr_signal, data: req_data, release0: release0, release1: release1}
    # Fetch (with internal BPU). Its pc is exposed as pc_signal.
    - name: fetch
      module: "examples/fetch_comp/fetch_comp.isir"
      lift_properties: false
      port_map: {stall: stall, taken: taken, branch_target: branch_target, pc: pc_signal}
    - name: ooo
      module: "examples/ooo_comp/ooo_comp.isir"
      lift_properties: false
      port_map: {issue_valid: issue_valid, rd: rd, op: op, alu_op: alu_op, store: store, a: a, b: b, addr: addr}
    # Two-level cache: L1I fed by pc_signal, L1D fed by the data request.
    - name: cache
      module: "examples/cache_comp/cache_comp.isir"
      parameters: {me: $me}
      lift_properties: false
      port_map: {i_addr: pc_signal, d_core: req_core, d_write: req_write, d_addr: pa_signal, d_data: req_data, l2_miss_valid: miss_valid_signal, l2_miss_addr: miss_addr_signal}
    - name: axi_mem
      module: "examples/axi_mem/axi_mem.isir"
      lift_properties: false
      port_map: {araddr: miss_addr_signal, arvalid: miss_valid_signal, awaddr: awaddr, awvalid: awvalid, wdata: wdata, wvalid: wvalid}
  state:
    # Shared signal carrying the fetch stage's program counter.
    - name: pc_signal
      kind: register
      type: "bits<4>"
      initial: 0
    - name: pa_signal
      kind: register
      type: "bits<4>"
      initial: 0
    - name: miss_valid_signal
      kind: register
      type: "bool"
      initial: false
    - name: miss_addr_signal
      kind: register
      type: "bits<4>"
      initial: 0
    - name: tlb_miss_signal
      kind: register
      type: "bool"
      initial: false
    - name: ptw_ppn_signal
      kind: register
      type: "bits<20>"
      initial: 0
    - name: tlb_ppn_in
      kind: register
      type: "bits<4>"
      initial: 0
    - name: pc
      kind: register
      type: "bits<4>"
      initial: 0
  rules:
    # Truncate the PTW's 20-bit PPN to the TLB's 4-bit fill source.
    - name: slice_ptw_ppn
      condition: "true"
      action:
        - (write tlb_ppn_in (slice (read ptw_ppn_signal) 3 0))
    - name: retire
      condition: (eq req_core $me)
      action:
        - (write pc (add (read pc) 1))
  properties:
    - name: pc_increments
      kind: transition
      expression:
        kind: transition
        rule: retire
        operand: (eq (read pc) (add (prev pc) 1))
    - name: tlb_hit_sets_pa
      kind: transition
      expression:
        kind: transition
        rule: tlb_hit0
        operand: (eq (read pa_signal) (read tlb_way0_ppn))
    - name: l2_miss_issues_axi
      kind: transition
      expression:
        kind: transition
        rule: cache_l2_read_miss0
        operand: (eq (read miss_valid_signal) true)
    - name: miss_allocates_mshr
      kind: transition
      expression:
        kind: transition
        rule: mshr_mshr0_alloc
        operand: (eq (read miss_valid_signal) true)
    - name: tlb_miss_triggers_ptw
      kind: transition
      expression:
        kind: transition
        rule: tlb_fill0
        operand: (eq (read tlb_miss_signal) true)
  proof_obligations:
    - property: pc_increments
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: tlb_hit_sets_pa
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: l2_miss_issues_axi
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: miss_allocates_mshr
      status: unproved
      engine: theorem_proving
      backend: koika
    - property: tlb_miss_triggers_ptw
      status: unproved
      engine: theorem_proving
      backend: koika
