isir_version: "0.1"
module:
  name: vec_engine
  clocks:
    - name: clk
      edge: posedge
      period: "10ns"
  resets:
    - name: rst_n
      polarity: active_low
      async: false
      affects: all
  inputs:
    - name: op
      direction: input
      type: "bits<2>"
    - name: a
      direction: input
      type: "bits<8>"
    - name: b
      direction: input
      type: "bits<8>"
    - name: valid
      direction: input
      type: "bool"
  components:
    - name: mac_unit
      module: "examples/mac/mac.isir"
      lift_properties: false
      port_map:
        a: a
        b: b
        enable: valid
        acc: mac_acc
        acc_out: mac_acc_out
  state:
    - name: out
      kind: register
      type: "bits<32>"
      initial: 0
    - name: mac_acc
      kind: register
      type: "bits<32>"
      initial: 0
    - name: mac_acc_out
      kind: register
      type: "bits<32>"
      initial: 0
  functions:
    - name: clamp8
      params:
        - name: x
          type: "bits<32>"
      return: "bits<32>"
      body: (min x 255)
  rules:
    - name: compute
      condition: valid
      action:
        - (write out (clamp8 (ite (eq op 0) (add a b) (read mac_acc_out))))
  properties:
    - name: out_equals_clamped_op
      kind: safety
      expression:
        kind: always
        operand: (eq (read out) (clamp8 (ite (eq op 0) (add a b) (read mac_acc_out))))
    - name: lane_op_computed
      kind: transition
      expression:
        kind: transition
        rule: compute
        operand: (eq (read out) (clamp8 (ite (eq op 0) (add a b) (prev mac_acc_out))))
  proof_obligations:
    - property: lane_op_computed
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
    - property: out_equals_clamped_op
      status: unproved
      engine: theorem_proving
      backend: koika_acl2
