specir_version: "0.1"
module:
  name: fifo
  clocks:
    - name: clk
      edge: posedge
  resets:
    - name: rst
      polarity: active_high
      async: false
      affects: all
  inputs:
    - name: data_in
      direction: input
      type: "bits<32>"
    - name: write_en
      direction: input
      type: "bool"
    - name: read_en
      direction: input
      type: "bool"
  outputs:
    - name: data_out
      direction: output
      type: "bits<32>"
    - name: full
      direction: output
      type: "bool"
    - name: empty
      direction: output
      type: "bool"
  state:
    - name: mem
      kind: memory
      type: { type: "memory", elem: "bits<32>", depth: 8 }
    - name: write_ptr
      kind: register
      type: "bits<3>"
      initial: 0
    - name: read_ptr
      kind: register
      type: "bits<3>"
      initial: 0
    - name: count
      kind: register
      type: "bits<4>"
      initial: 0
    - name: data_out
      kind: register
      type: "bits<32>"
      initial: 0
    - name: full
      kind: register
      type: "bool"
      initial: false
    - name: empty
      kind: register
      type: "bool"
      initial: true
  rules:
    - name: write
      condition: (and write_en (not (read full)))
      action:
        - (mem_write mem (read write_ptr) data_in)
        - (write write_ptr (add (read write_ptr) 1))
        - (write count (add (read count) 1))
    - name: read
      condition: (and read_en (not (read empty)))
      action:
        - (write data_out (mem_read mem (read read_ptr)))
        - (write read_ptr (add (read read_ptr) 1))
        - (write count (sub (read count) 1))
    - name: update_flags
      condition: "true"
      action:
        - (write full (eq (read count) 8))
        - (write empty (eq (read count) 0))
  properties:
    - name: no_overflow
      kind: safety
      expression:
        kind: always
        operand: (implies (and write_en (read full)) false)
    - name: no_underflow
      kind: safety
      expression:
        kind: always
        operand: (implies (and read_en (read empty)) false)
    - name: count_bound
      kind: safety
      expression:
        kind: always
        operand: (and (ge (read count) 0) (le (read count) 8))
    - name: fifo_bound
      kind: safety
      expression:
        kind: always
        operand: (and (ge (read count) 0) (le (read count) 8))
    # --- ACL2‑friendly test properties (register‑only) ---
    - name: write_ptr_self
      kind: safety
      expression:
        kind: always
        operand: (eq (read write_ptr) (read write_ptr))
    - name: read_ptr_self
      kind: safety
      expression:
        kind: always
        operand: (eq (read read_ptr) (read read_ptr))
    - name: full_is_bool
      kind: safety
      expression:
        kind: always
        operand: (or (eq (read full) true) (eq (read full) false))
    - name: empty_is_bool
      kind: safety
      expression:
        kind: always
        operand: (or (eq (read empty) true) (eq (read empty) false))
    - name: write_ptr_nonneg
      kind: safety
      expression:
        kind: always
        operand: (ge (read write_ptr) 0)
    - name: read_ptr_nonneg
      kind: safety
      expression:
        kind: always
        operand: (ge (read read_ptr) 0)

  proof_obligations:
    # Theorem proving (existing)
    - property: fifo_bound
      status: unproved
      engine: theorem_proving
      backend: koika

    # ACL2 obligations
    - property: write_ptr_self
      status: unproved
      engine: theorem_proving
      backend: acl2
    - property: read_ptr_self
      status: unproved
      engine: theorem_proving
      backend: acl2
    - property: full_is_bool
      status: unproved
      engine: theorem_proving
      backend: acl2
    - property: empty_is_bool
      status: unproved
      engine: theorem_proving
      backend: acl2
    - property: write_ptr_nonneg
      status: unproved
      engine: theorem_proving
      backend: acl2
    - property: read_ptr_nonneg
      status: unproved
      engine: theorem_proving
      backend: acl2

    # Model checking obligations (new)
    - property: no_overflow
      engine: model_checking
    - property: no_underflow
      engine: model_checking